{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/release-report-artifact-inventory-v1.schema.json",
  "title": "CrossGL Release Report Artifact Inventory JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundlePath",
    "publishPlanPath",
    "stageReportPath",
    "success",
    "artifactRecordCount",
    "bundleArtifactRecordCount",
    "publishPlanArtifactRecordCount",
    "publishStageArtifactRecordCount",
    "stagedArtifactRecordCount",
    "totalArtifactRecordBytes",
    "records",
    "diagnosticCounts",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "bundlePath": {
      "$ref": "#/$defs/nullableString"
    },
    "publishPlanPath": {
      "$ref": "#/$defs/nullableString"
    },
    "stageReportPath": {
      "$ref": "#/$defs/nullableString"
    },
    "success": {
      "type": "boolean"
    },
    "artifactRecordCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "bundleArtifactRecordCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "publishPlanArtifactRecordCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "publishStageArtifactRecordCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "stagedArtifactRecordCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "totalArtifactRecordBytes": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "diagnosticCounts": {
      "$ref": "#/$defs/diagnosticCounts"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSize": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRecordKind",
        "packagePath",
        "packageArtifactPath",
        "stagedPath",
        "destinationPath",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "sourceRecordKind": {
          "type": "string",
          "enum": [
            "release-bundle",
            "publish-plan",
            "publish-stage"
          ]
        },
        "packagePath": {
          "type": "string"
        },
        "packageArtifactPath": {
          "type": "string"
        },
        "stagedPath": {
          "$ref": "#/$defs/nullableString"
        },
        "destinationPath": {
          "$ref": "#/$defs/nullableString"
        },
        "sizeBytes": {
          "$ref": "#/$defs/nullableSize"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "warning",
        "error"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "error": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "offset",
        "length",
        "endLine",
        "endColumn",
        "endOffset"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "location"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "note",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/sourceLocation"
        },
        "target": {
          "type": "string"
        },
        "missingCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
