{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/package-release-promotion-manifest-v1.schema.json",
  "title": "CrossGL Package Release Promotion Manifest JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summaryPath",
    "manifestPath",
    "batchPath",
    "status",
    "releaseEligible",
    "blockerCount",
    "blockers",
    "packageCount",
    "packages",
    "summary",
    "diagnosticCounts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "summaryPath": {
      "type": "string"
    },
    "manifestPath": {
      "type": "string"
    },
    "batchPath": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "eligible",
        "blocked"
      ]
    },
    "releaseEligible": {
      "type": "boolean"
    },
    "blockerCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "packageCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "diagnosticCounts": {
      "$ref": "#/$defs/diagnosticCounts"
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "warning",
        "error"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "error": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "count"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "count": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSize": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceHash": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "nativeBinaryStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "planned",
            "emitted",
            "validated"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "packageArtifactRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "packageMode",
        "requiredPathArtifacts",
        "requiresNativeBinaryStatus",
        "allowsPlannedNativeBinary",
        "allowsPlannedNativeSourceEvidence"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "metal",
            "vulkan",
            "directx",
            "opengl"
          ]
        },
        "packageMode": {
          "type": "string",
          "enum": [
            "native",
            "source-package"
          ]
        },
        "requiredPathArtifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "backendSource",
              "backendAssembly",
              "intermediate",
              "nativeBinary"
            ]
          }
        },
        "requiresNativeBinaryStatus": {
          "type": "boolean"
        },
        "allowsPlannedNativeBinary": {
          "type": "boolean"
        },
        "allowsPlannedNativeSourceEvidence": {
          "type": "boolean"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "exists",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "sizeBytes": {
          "$ref": "#/$defs/nullableSize"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packagePath",
        "module",
        "target",
        "sourceHash",
        "nativeBinaryStatus",
        "packageArtifactRequirements",
        "artifactCount",
        "artifacts"
      ],
      "properties": {
        "packagePath": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "enum": [
            "metal",
            "vulkan",
            "directx",
            "opengl"
          ]
        },
        "sourceHash": {
          "$ref": "#/$defs/sourceHash"
        },
        "nativeBinaryStatus": {
          "$ref": "#/$defs/nativeBinaryStatus"
        },
        "packageArtifactRequirements": {
          "$ref": "#/$defs/packageArtifactRequirements"
        },
        "artifactCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summaryPath",
        "batchPath",
        "success",
        "matches",
        "releaseEligible",
        "verificationCount",
        "matchedCount",
        "mismatchedCount",
        "failedCount",
        "scannedPackageCount",
        "setPackageCount",
        "missingFromSetCount",
        "extraInSetCount",
        "diagnosticCounts"
      ],
      "properties": {
        "summaryPath": {
          "type": "string"
        },
        "batchPath": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "matches": {
          "type": "boolean"
        },
        "releaseEligible": {
          "type": "boolean"
        },
        "verificationCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "matchedCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "mismatchedCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failedCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "scannedPackageCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "setPackageCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "missingFromSetCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "extraInSetCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "diagnosticCounts": {
          "$ref": "#/$defs/diagnosticCounts"
        }
      }
    }
  }
}
