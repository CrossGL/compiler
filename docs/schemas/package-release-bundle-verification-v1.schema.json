{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/package-release-bundle-verification-v1.schema.json",
  "title": "CrossGL Package Release Bundle Verification JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundlePath",
    "success",
    "status",
    "releaseEligible",
    "blockerCount",
    "packageCount",
    "artifactCount",
    "existingArtifactCount",
    "missingArtifactCount",
    "totalArtifactBytes",
    "verifiedArtifactCount",
    "diagnosticCounts",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "bundlePath": {
      "type": "string"
    },
    "success": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "eligible",
        "blocked",
        "invalid"
      ]
    },
    "releaseEligible": {
      "type": "boolean"
    },
    "blockerCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "packageCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "artifactCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "existingArtifactCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "missingArtifactCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "totalArtifactBytes": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "verifiedArtifactCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "diagnosticCounts": {
      "$ref": "#/$defs/diagnosticCounts"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "warning",
        "error"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "error": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "offset",
        "length",
        "endLine",
        "endColumn",
        "endOffset"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "location"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "note",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/sourceLocation"
        },
        "target": {
          "type": "string"
        },
        "missingCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
