        "weightClass": {
          "type": "string",
          "enum": [
            "static-normalized",
            "static-non-normalized",
            "static-zero-sum",
            "dynamic",
            "unknown"
          ]
        },
        "tapCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "weightsStatic": {
          "type": "boolean"
        },
        "weightSum": {
          "type": "number"
        },
        "weightsZeroSum": {
          "type": "boolean"
        },
        "weightsNormalized": {
          "type": "boolean"
        }
      }
    },
    "resourceSourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "resourceRecordKind",
        "stage",
        "entryPoint",
        "resourceName",
        "resourceKind",
        "location"
      ],
      "properties": {
        "index": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "resourceRecordKind": {
          "type": "string",
          "enum": [
            "declaration",
            "layout",
            "set",
            "binding",
            "access"
          ]
        },
        "stage": {
          "type": "string"
        },
        "entryPoint": {
          "type": "string"
        },
        "resourceName": {
          "type": "string",
          "minLength": 1
        },
        "resourceKind": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string"
        },
        "ownerKind": {
          "type": "string"
        },
        "ownerName": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
