        "staticNonNormalized": {
          "$ref": "#/$defs/indexList"
        },
        "staticZeroSum": {
          "$ref": "#/$defs/indexList"
        },
        "dynamic": {
          "$ref": "#/$defs/indexList"
        }
      }
    },
    "manualTextureCompareKernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "stage",
        "entryPoint",
        "function",
        "operation",
        "sourceKind",
        "canonicalOperation",
        "compatibilityAlias",
        "weightClass",
        "tapCount",
        "weightsStatic",
        "weightsZeroSum",
