          "type": "string",
          "enum": [
            "read",
            "write",
            "sample",
            "load",
            "store",
            "atomic",
            "call",
            "bind",
            "unknown"
          ]
        },
        "accessPath": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "memberName": {
          "type": "string"
