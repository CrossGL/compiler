{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/package-maintenance-policy-v1.schema.json",
  "title": "CrossGL Package Maintenance Policy JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "staleSidecars"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "staleSidecars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keepLast": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "olderThanSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
