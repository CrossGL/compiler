{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/package-inspect-v1.schema.json",
  "title": "CrossGL Package Inspect JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packagePath"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/successDocument"
    },
    {
      "$ref": "#/$defs/failureDocument"
    }
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "packagePath": {
      "type": "string"
    },
    "success": {
      "type": "boolean"
    },
    "packageFormat": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "directory",
        null
      ]
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/summary"
        },
        {
          "type": "null"
        }
      ]
    },
    "debugArtifacts": {
      "anyOf": [
        {
          "$ref": "#/$defs/debugArtifacts"
        },
        {
          "type": "null"
        }
      ]
    },
    "vulkanNativeProfile": {
      "anyOf": [
        {
          "$ref": "#/$defs/vulkanNativeProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "nativeArtifactDescriptor": {
      "anyOf": [
        {
          "$ref": "#/$defs/nativeArtifactDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "graphicsAbi": {
      "$ref": "#/$defs/graphicsAbi"
    },
    "artifactRequirementsProjection": {
      "$ref": "#/$defs/artifactRequirementsProjection"
    },
    "targetLegalizationEvidence": {
      "$ref": "#/$defs/targetLegalizationEvidence"
    },
    "packageArtifactRequirements": {
      "$ref": "#/$defs/packageArtifactRequirements"
    },
    "publication": {
      "anyOf": [
        {
          "$ref": "#/$defs/publication"
        },
        {
          "type": "null"
        }
      ]
    },
    "rootFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRecord"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRecord"
      }
    },
    "manifest": {
      "type": [
        "object",
        "null"
      ]
    },
    "reflection": {
      "type": [
        "object",
        "null"
      ]
    },
    "diagnosticCounts": {
      "$ref": "#/$defs/diagnosticCounts"
    },
    "diagnostics": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      ]
    }
  },
  "$defs": {
    "successDocument": {
      "required": [
        "packageFormat",
        "summary",
        "rootFiles",
        "artifacts",
        "manifest",
        "reflection",
        "diagnostics"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "success"
            ]
          },
          {
            "required": [
              "diagnosticCounts"
            ]
          }
        ]
      },
      "properties": {
        "packageFormat": {
          "const": "directory"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "debugArtifacts": {
          "$ref": "#/$defs/debugArtifacts"
        },
        "vulkanNativeProfile": {
          "$ref": "#/$defs/vulkanNativeProfile"
        },
        "nativeArtifactDescriptor": {
          "$ref": "#/$defs/nativeArtifactDescriptor"
        },
        "graphicsAbi": {
          "$ref": "#/$defs/graphicsAbi"
        },
        "artifactRequirementsProjection": {
          "$ref": "#/$defs/artifactRequirementsProjection"
        },
        "targetLegalizationEvidence": {
          "$ref": "#/$defs/targetLegalizationEvidence"
        },
        "packageArtifactRequirements": {
          "$ref": "#/$defs/packageArtifactRequirements"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        },
        "rootFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileRecord"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRecord"
          }
        },
        "manifest": {
          "type": "object"
        },
        "reflection": {
          "type": "object"
        },
        "diagnostics": {
          "type": "object"
        }
      }
    },
    "failureDocument": {
      "required": [
        "success",
        "packageFormat",
        "summary",
        "diagnosticCounts",
        "diagnostics"
      ],
      "properties": {
        "success": {
          "const": false
        },
        "packageFormat": {
          "type": "null"
        },
        "summary": {
          "type": "null"
        },
        "diagnosticCounts": {
          "$ref": "#/$defs/diagnosticCounts"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "warning",
        "error"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "error": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "diagnosticSeverity": {
      "type": "string",
      "enum": [
        "note",
        "warning",
        "error"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "location"
      ],
      "properties": {
        "severity": {
          "$ref": "#/$defs/diagnosticSeverity"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/sourceLocation"
        },
        "target": {
          "type": "string"
        },
        "missingCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "graphicsAbiSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "target",
        "entryPointCount",
        "vertexInputCount",
        "varyingCount",
        "fragmentOutputCount",
        "builtinCount",
        "resourceCount",
        "abiRecordCount"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "entryPointCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "vertexInputCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "varyingCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "fragmentOutputCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "builtinCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "resourceCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "abiRecordCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "graphicsAbiDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "pattern": "^package[.]graphicsAbi[.]"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "graphicsAbi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPresent",
        "path",
        "exists",
        "health",
        "validation",
        "schemaVersion",
        "summary",
        "diagnosticCounts",
        "diagnostics"
      ],
      "properties": {
        "artifactPresent": {
          "const": true
        },
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "health": {
          "type": "string",
          "enum": [
            "missing",
            "invalid",
            "drift",
            "ok"
          ]
        },
        "validation": {
          "const": "lightweight-structural"
        },
        "schemaVersion": {
          "$ref": "#/$defs/nullableInteger"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/graphicsAbiSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnosticCounts": {
          "$ref": "#/$defs/diagnosticCounts"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphicsAbiDiagnostic"
          }
        }
      }
    },
    "targetName": {
      "type": "string",
      "enum": [
        "metal",
        "vulkan",
        "directx",
        "opengl"
      ]
    },
    "packageMode": {
      "type": "string",
      "enum": [
        "native",
        "source-package"
      ]
    },
    "targetLegalizationPackageMode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "native",
        "source-package",
        "unsupported",
        "unknown",
        null
      ]
    },
    "packageDecisionReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "native-package-available",
        "source-package-available",
        "package-build-available",
        "unsupported",
        null
      ]
    },
    "nullableStringArray": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "nullableNonNegativeInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "nullableToolIdArray": {
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(metal|vulkan|directx|opengl)\\.(native-tool|toolchain|validation)\\.[A-Za-z0-9_.-]+$"
      }
    },
    "nullableOptionalNativeToolStatus": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "available",
        "missing",
        "not-required",
        null
      ]
    },
    "targetLegalizationSidecarEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPresent",
        "artifactExists",
        "target",
        "packageMode",
        "packageDecisionReason",
        "requiredToolCount",
        "missingToolCount",
        "requiredToolIds",
        "missingToolIds",
        "optionalNativeToolMissing",
        "optionalNativeToolStatus",
        "toolRequirementEvidenceIds",
        "legalizationCoreEvidenceIds",
        "packageArtifactRequirementEvidenceIds"
      ],
      "properties": {
        "artifactPresent": {
          "type": "boolean"
        },
        "artifactExists": {
          "type": "boolean"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "metal",
            "vulkan",
            "directx",
            "opengl",
            null
          ]
        },
        "packageMode": {
          "$ref": "#/$defs/targetLegalizationPackageMode"
        },
        "packageDecisionReason": {
          "$ref": "#/$defs/packageDecisionReason"
        },
        "requiredToolCount": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "missingToolCount": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "requiredToolIds": {
          "$ref": "#/$defs/nullableToolIdArray"
        },
        "missingToolIds": {
          "$ref": "#/$defs/nullableToolIdArray"
        },
        "optionalNativeToolMissing": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "optionalNativeToolStatus": {
          "$ref": "#/$defs/nullableOptionalNativeToolStatus"
        },
        "toolRequirementEvidenceIds": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "legalizationCoreEvidenceIds": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "packageArtifactRequirementEvidenceIds": {
          "$ref": "#/$defs/nullableStringArray"
        }
      }
    },
    "targetLegalizationManifestToolRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "target",
        "packageMode",
        "requiredToolCount",
        "missingToolCount",
        "requiredToolIds",
        "missingToolIds",
        "optionalNativeToolMissing",
        "optionalNativeToolStatus",
        "toolRequirementEvidenceIds"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "metal",
            "vulkan",
            "directx",
            "opengl",
            null
          ]
        },
        "packageMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "native",
            "source-package",
            null
          ]
        },
        "requiredToolCount": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "missingToolCount": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "requiredToolIds": {
          "$ref": "#/$defs/nullableToolIdArray"
        },
        "missingToolIds": {
          "$ref": "#/$defs/nullableToolIdArray"
        },
        "optionalNativeToolMissing": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "optionalNativeToolStatus": {
          "$ref": "#/$defs/nullableOptionalNativeToolStatus"
        },
        "toolRequirementEvidenceIds": {
          "$ref": "#/$defs/nullableStringArray"
        }
      }
    },
    "targetLegalizationEvidenceChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestToolRequirementsTargetMatchesPackage",
        "manifestToolRequirementsPackageModeMatchesRequirements",
        "manifestToolRequirementEvidenceIdsPresent",
        "debugMetadataTargetMatchesPackage",
        "targetExplanationTargetMatchesPackage",
        "debugMetadataPackageModeMatchesRequirements",
        "targetExplanationPackageModeMatchesRequirements",
        "debugMetadataToolRequirementsMatchManifest",
        "targetExplanationToolRequirementsMatchManifest",
        "packageArtifactRequirementEvidenceIdsPresent"
      ],
      "properties": {
        "manifestToolRequirementsTargetMatchesPackage": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "manifestToolRequirementsPackageModeMatchesRequirements": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "manifestToolRequirementEvidenceIdsPresent": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "debugMetadataTargetMatchesPackage": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "targetExplanationTargetMatchesPackage": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "debugMetadataPackageModeMatchesRequirements": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "targetExplanationPackageModeMatchesRequirements": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "debugMetadataToolRequirementsMatchManifest": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "targetExplanationToolRequirementsMatchManifest": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "packageArtifactRequirementEvidenceIdsPresent": {
          "$ref": "#/$defs/nullableBoolean"
        }
      }
    },
    "targetLegalizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health",
        "packageMode",
        "packageModeSource",
        "manifestToolRequirements",
        "debugMetadata",
        "targetExplanation",
        "packageArtifactRequirementEvidenceIds",
        "missingEvidence",
        "checks"
      ],
      "properties": {
        "health": {
          "type": "string",
          "enum": [
            "not-present",
            "incomplete",
            "partial",
            "drift",
            "ok"
          ]
        },
        "packageMode": {
          "$ref": "#/$defs/targetLegalizationPackageMode"
        },
        "packageModeSource": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "manifest.packageArtifactRequirements",
            "debugMetadata.targetDecision.selectedTargetPackageMode",
            "targetExplanation.targets[].packageMode",
            null
          ]
        },
        "manifestToolRequirements": {
          "$ref": "#/$defs/targetLegalizationManifestToolRequirements"
        },
        "debugMetadata": {
          "$ref": "#/$defs/targetLegalizationSidecarEvidence"
        },
        "targetExplanation": {
          "$ref": "#/$defs/targetLegalizationSidecarEvidence"
        },
        "packageArtifactRequirementEvidenceIds": {
          "$ref": "#/$defs/nullableStringArray"
        },
        "missingEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "$ref": "#/$defs/targetLegalizationEvidenceChecks"
        }
      }
    },
    "requiredPathArtifactName": {
      "type": "string",
      "enum": [
        "backendSource",
        "backendAssembly",
        "intermediate",
        "nativeBinary"
      ]
    },
    "requiredPathArtifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/requiredPathArtifactName"
        },
        "location": {
          "$ref": "#/$defs/sourceLocation"
        }
      }
    },
    "packageArtifactRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "packageMode",
        "requiredPathArtifacts",
        "requiresNativeBinaryStatus",
        "allowsPlannedNativeBinary",
        "allowsPlannedNativeSourceEvidence",
        "location"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "packageMode": {
          "$ref": "#/$defs/packageMode"
        },
        "requiredPathArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requiredPathArtifactRecord"
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiresNativeBinaryStatus": {
          "type": "boolean"
        },
        "allowsPlannedNativeBinary": {
          "type": "boolean"
        },
        "allowsPlannedNativeSourceEvidence": {
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/sourceLocation"
        },
        "targetLocation": {
          "$ref": "#/$defs/sourceLocation"
        },
        "packageModeLocation": {
          "$ref": "#/$defs/sourceLocation"
        },
        "requiredPathArtifactsLocation": {
          "$ref": "#/$defs/sourceLocation"
        },
        "evidenceIdsLocation": {
          "$ref": "#/$defs/sourceLocation"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "target",
        "nativeBinaryStatus",
        "artifactCount",
        "debugArtifactsPresent"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "nativeBinaryStatus": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "planned",
            "emitted",
            "validated",
            null
          ]
        },
        "artifactCount": {
          "type": "integer",
          "minimum": 0
        },
        "debugArtifactsPresent": {
          "type": "boolean"
        },
        "reflection": {
          "$ref": "#/$defs/reflectionSummary"
        }
      }
    },
    "targetLegalizationTargetFeatureEvidenceId": {
      "type": "string",
      "pattern": "^target-legalization\\.v1\\.(metal|vulkan|directx|opengl)\\.(capability\\.(required|missing)\\.(metal|vulkan|directx|opengl)\\.[A-Za-z0-9_.-]+|abi\\.(required|missing)\\.[A-Za-z0-9_.-]+)$"
    },
    "reflectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetFeatureCount": {
          "type": "integer",
          "minimum": 0
        },
        "targetFeatureEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetLegalizationTargetFeatureEvidenceId"
          },
          "uniqueItems": true
        }
      }
    },
    "nullableBoolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sidecarKind": {
      "type": "string",
      "enum": [
        "staging",
        "previous"
      ]
    },
    "nullableSidecarKind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "staging",
        "previous",
        null
      ]
    },
    "debugArtifactChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hirSourceLocationsMatch",
        "sourceMapUnfiltered",
        "sourceMapUnpaged",
        "sourceMapRecordsDisabled",
        "sourceMapCategoryCountsConsistent",
        "recordsTotalCountMatchesCategoryCounts"
      ],
      "properties": {
        "hirSourceLocationsMatch": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "sourceMapUnfiltered": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "sourceMapUnpaged": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "sourceMapRecordsDisabled": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "sourceMapCategoryCountsConsistent": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "recordsTotalCountMatchesCategoryCounts": {
          "$ref": "#/$defs/nullableBoolean"
        }
      }
    },
    "sourceRemapProvenanceChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityMatchesContract",
        "targetMatchesPackage",
        "generatedFilePresent",
        "mappingGranularityMatchesContract",
        "mappingCountPositive",
        "sourcePathPresent",
        "sourceHashPresent",
        "sourceSizeBytesPresent"
      ],
      "properties": {
        "identityMatchesContract": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "targetMatchesPackage": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "generatedFilePresent": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "mappingGranularityMatchesContract": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "mappingCountPositive": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "sourcePathPresent": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "sourceHashPresent": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "sourceSizeBytesPresent": {
          "$ref": "#/$defs/nullableBoolean"
        }
      }
    },
    "sourceRemapProvenance": {
      "type": "object",
