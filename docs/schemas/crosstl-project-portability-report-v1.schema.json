{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/crosstl-project-portability-report-v1.schema.json",
  "title": "CrossTL Project Portability Report Compatibility Schema v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "kind",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "crosstl-project-portability-report"
    },
    "generatedAt": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "stableRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.\\.?$)[^/]+(?:/[^/]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "targetName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "sha256Hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pipeline": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "packageVersion": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "root": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetName"
          }
        },
        "outputDir": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifactCount",
        "sourceRemapCount",
        "sourceRemapMappingCount"
      ],
      "properties": {
        "artifactCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "translatedCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failedCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "sourceMapCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "fineGrainedSourceMapCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "sourceMapsByGranularity": {
          "$ref": "#/$defs/countMap"
        },
        "sourceMapsByTarget": {
          "$ref": "#/$defs/countMap"
        },
        "sourceMapsBySourceBackend": {
          "$ref": "#/$defs/countMap"
        },
        "sourceMapsByVariant": {
          "$ref": "#/$defs/countMap"
        },
        "sourceRemapCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "sourceRemapMappingCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "sourceRemapsByGranularity": {
          "$ref": "#/$defs/countMap"
        },
        "sourceRemapsByTarget": {
          "$ref": "#/$defs/countMap"
        },
        "sourceRemapsBySourceBackend": {
          "$ref": "#/$defs/countMap"
        },
        "sourceRemapsByVariant": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nonNegativeInteger"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {
          "$ref": "#/$defs/stableRelativePath"
        },
        "sourceBackend": {
          "$ref": "#/$defs/targetName"
        },
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "path": {
          "$ref": "#/$defs/stableRelativePath"
        },
        "variant": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceMap": {
          "$ref": "#/$defs/sourceMapMetadata"
        },
        "sourceRemap": {
          "$ref": "#/$defs/sourceRemapMetadata"
        }
      }
    },
    "mappingGranularity": {
      "type": "string",
      "enum": [
        "file",
        "line",
        "statement",
        "token"
      ]
    },
    "sourceMapMetadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "kind",
        "mappingGranularity",
        "target",
        "source",
        "generated",
        "mappings"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "crosstl-artifact-source-map"
        },
        "mappingGranularity": {
          "$ref": "#/$defs/mappingGranularity"
        },
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "source": {
          "$ref": "#/$defs/sourceMapSpan"
        },
        "generated": {
          "$ref": "#/$defs/sourceMapSpan"
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceMapMapping"
          }
        }
      }
    },
    "sourceRemapMetadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "path",
        "target",
        "generatedFile",
        "mappingGranularity",
        "mappingCount",
        "sizeBytes",
        "hash"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "path": {
          "$ref": "#/$defs/stableRelativePath",
          "description": "Relative path to the compiler source-remap sidecar consumed by cglc --source-remap."
        },
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "generatedFile": {
          "$ref": "#/$defs/stableRelativePath"
        },
        "mappingGranularity": {
          "$ref": "#/$defs/mappingGranularity"
        },
        "mappingCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "sizeBytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hash": {
          "$ref": "#/$defs/sha256Hash"
        }
      }
    },
    "sourceMapMapping": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "generated"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/sourceMapSpan"
        },
        "generated": {
          "$ref": "#/$defs/sourceMapSpan"
        }
      }
    },
    "sourceMapSpan": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "file",
        "line",
        "column",
        "offset",
        "length",
        "endLine",
        "endColumn",
        "endOffset"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/stableRelativePath"
        },
        "line": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "column": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "length": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "endLine": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "endColumn": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "endOffset": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    }
  }
}
