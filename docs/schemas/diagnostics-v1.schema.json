{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/diagnostics-v1.schema.json",
  "title": "CrossGL Diagnostics JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "targetName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$",
      "description": "Compiler diagnostics use one of metal, vulkan, directx, or opengl. Project diagnostics may use an open, stable project/config target selector such as webgpu or workspace.default."
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "offset",
        "length",
        "endLine",
        "endColumn",
        "endOffset"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "Stable slash-separated relative source path. Absolute host paths are rejected by diagnostics-v1 semantics."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "location"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "note",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/sourceLocation"
        },
        "originalLocation": {
          "$ref": "#/$defs/sourceLocation",
          "description": "Optional generated-to-original source span when diagnostics are emitted with a source remap sidecar. The required location field remains the compiler-input span."
        },
        "target": {
          "$ref": "#/$defs/targetName"
        },
        "missingCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
