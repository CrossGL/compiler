{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/package-release-publish-upload-batch-v1.schema.json",
  "title": "CrossGL Package Release Publish Upload Batch JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestPath",
    "reportPath",
    "reportWritten",
    "uploadMode",
    "success",
    "requestCount",
    "requestBytes",
    "uploadedArtifactCount",
    "uploadedArtifactBytes",
    "uploadedRequests",
    "diagnosticCounts",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "manifestPath": {
      "type": "string"
    },
    "reportPath": {
      "type": "string"
    },
    "reportWritten": {
      "type": "boolean"
    },
    "uploadMode": {
      "type": "string",
      "enum": [
        "custom",
        "mock",
        "gcs"
      ]
    },
    "success": {
      "type": "boolean"
    },
    "requestCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "requestBytes": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "uploadedArtifactCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "uploadedArtifactBytes": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "uploadedRequests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "diagnosticCounts": {
      "$ref": "#/$defs/diagnosticCounts"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetKind",
        "stagedPath",
        "destinationPath",
        "bucket",
        "objectName",
        "uploadUri",
        "credentialsEnv",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "targetKind": {
          "type": "string",
          "enum": [
            "gcs"
          ]
        },
        "stagedPath": {
          "type": "string"
        },
        "destinationPath": {
          "type": "string",
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:).*$"
        },
        "bucket": {
          "type": "string"
        },
        "objectName": {
          "type": "string",
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:).*$"
        },
        "uploadUri": {
          "type": "string"
        },
        "credentialsEnv": {
          "type": "string"
        },
        "sizeBytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "warning",
        "error"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "error": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "offset",
        "length",
        "endLine",
        "endColumn",
        "endOffset"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "location"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "note",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/sourceLocation"
        },
        "target": {
          "type": "string"
        },
        "missingCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
