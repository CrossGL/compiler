{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/source-remap-v1.schema.json",
  "title": "CrossGL Source Remap Sidecar Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedFile",
    "mappings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedFile": {
      "$ref": "#/$defs/stableRelativePath",
      "description": "Stable compiler-input path used by diagnostics and source maps, usually the same value passed to --logical-input."
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "stableRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.\\.?$)[^/]+(?:/[^/]+)*$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "offset",
        "length",
        "endLine",
        "endColumn",
        "endOffset"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/stableRelativePath"
        },
        "line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "column": {
          "$ref": "#/$defs/positiveInteger"
        },
        "offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "length": {
          "$ref": "#/$defs/positiveInteger"
        },
        "endLine": {
          "$ref": "#/$defs/positiveInteger"
        },
        "endColumn": {
          "$ref": "#/$defs/positiveInteger"
        },
        "endOffset": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated",
        "original"
      ],
      "properties": {
        "generated": {
          "$ref": "#/$defs/sourceSpan",
          "description": "Generated span in the compiler-input path. Semantic validation requires generated.file to match the top-level generatedFile."
        },
        "original": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    }
  }
}
