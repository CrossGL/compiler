{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/runtime-loader-plan-v1.schema.json",
  "title": "CrossGL Runtime Loader Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "success",
    "metadataOnly",
    "compilerInvocationRequired",
    "deviceExecutionRequired",
    "packageFormat",
    "packageTarget",
    "requestedLoaderTarget",
    "targetMatchesPackage",
    "requestedPackageMode",
    "selectedPackageMode",
    "selectedArtifact",
    "requiredMetadataInputs",
    "packageArtifactRequirementsSource",
    "packageArtifactRequirements",
    "targetLegalizationEvidenceSummary",
    "reflectionSummary",
    "diagnosticCounts",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "crossgl-runtime-loader-plan"
    },
    "success": {
      "type": "boolean"
    },
    "metadataOnly": {
      "type": "boolean",
      "const": true
    },
    "compilerInvocationRequired": {
      "type": "boolean",
      "const": false
    },
    "deviceExecutionRequired": {
      "type": "boolean",
      "const": false
    },
    "packageFormat": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "directory",
        "zip",
        null
      ]
    },
    "packageTarget": {
      "$ref": "#/$defs/packageTargetOrNull"
    },
    "requestedLoaderTarget": {
      "$ref": "#/$defs/packageTargetOrNull"
    },
    "targetMatchesPackage": {
      "type": "boolean"
    },
    "requestedPackageMode": {
      "$ref": "#/$defs/requestedPackageMode"
    },
    "selectedPackageMode": {
      "$ref": "#/$defs/selectedPackageModeOrNull"
    },
    "selectedArtifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/selectedArtifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "requiredMetadataInputs": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "packageArtifactRequirementsSource": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "manifest.packageArtifactRequirements",
        "generated-package-target-contract",
        null
      ]
    },
    "packageArtifactRequirements": {
      "anyOf": [
        {
          "$ref": "#/$defs/packageArtifactRequirements"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetLegalizationEvidenceSummary": {
      "anyOf": [
        {
          "$ref": "#/$defs/targetLegalizationEvidenceSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "reflectionSummary": {
      "anyOf": [
        {
          "$ref": "#/$defs/reflectionSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnosticCounts": {
      "$ref": "#/$defs/diagnosticCounts"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "packageTargetName": {
      "type": "string",
      "enum": [
        "metal",
        "vulkan",
        "directx",
        "opengl"
      ]
    },
    "packageTargetOrNull": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "metal",
        "vulkan",
        "directx",
        "opengl",
        null
      ]
    },
    "requestedPackageMode": {
      "type": "string",
      "enum": [
        "auto",
        "native",
        "source-package"
      ]
    },
    "selectedPackageMode": {
      "type": "string",
      "enum": [
        "native",
        "source-package"
      ]
    },
    "selectedPackageModeOrNull": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "native",
        "source-package",
        null
      ]
    },
    "selectedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "packageMode",
        "packageRelative",
        "exists"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "backendSource",
            "nativeBinary"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "packageMode": {
          "$ref": "#/$defs/selectedPackageMode"
        },
        "packageRelative": {
          "type": "boolean"
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "packageArtifactRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "packageMode",
        "requiredPathArtifacts",
        "requiresNativeBinaryStatus",
        "allowsPlannedNativeBinary",
        "allowsPlannedNativeSourceEvidence",
        "evidenceIds"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/packageTargetName"
        },
        "packageMode": {
          "$ref": "#/$defs/selectedPackageMode"
        },
        "requiredPathArtifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "backendSource",
              "backendAssembly",
              "intermediate",
              "nativeBinary"
            ]
          }
        },
        "requiresNativeBinaryStatus": {
          "type": "boolean"
        },
        "allowsPlannedNativeBinary": {
          "type": "boolean"
        },
        "allowsPlannedNativeSourceEvidence": {
          "type": "boolean"
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "targetLegalizationEvidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolRequirementsPresent",
        "target",
        "packageMode",
        "requiredToolCount",
        "missingToolCount",
        "requiredToolIds",
        "missingToolIds",
        "toolRequirementEvidenceIds"
      ],
      "properties": {
        "toolRequirementsPresent": {
          "type": "boolean"
        },
        "target": {
          "$ref": "#/$defs/packageTargetOrNull"
        },
        "packageMode": {
          "$ref": "#/$defs/selectedPackageModeOrNull"
        },
        "requiredToolCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "missingToolCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "requiredToolIds": {
          "$ref": "#/$defs/stringList"
        },
        "missingToolIds": {
          "$ref": "#/$defs/stringList"
        },
        "toolRequirementEvidenceIds": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "reflectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceCount",
        "targetResourceBindingCount",
        "targetFeatureCount",
        "entryPointCount",
        "workgroupSizeCount",
        "threadgroupShapeSource"
      ],
      "properties": {
        "resourceCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "targetResourceBindingCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "targetFeatureCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "entryPointCount": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "workgroupSizeCount": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "threadgroupShapeSource": {
          "type": "string",
          "const": "reflection.workgroupSizes"
        }
      }
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "warning",
        "error"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "error": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "location"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "note",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^(package|target|metal|vulkan|directx|opengl)\\.[A-Za-z0-9_.-]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/sourceLocation"
        },
        "target": {
          "type": "string"
        },
        "missingCapabilities": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "offset",
        "length",
        "endLine",
        "endColumn",
        "endOffset"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "column": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "offset": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "length": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "endLine": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "endColumn": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "endOffset": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nonNegativeIntegerOrNull": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
