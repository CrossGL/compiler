{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossgl.dev/schemas/package-maintenance-set-verification-batch-summary-v1.schema.json",
  "title": "CrossGL Package Maintenance Set Verification Batch Summary JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchPath",
    "success",
    "matches",
    "releaseEligible",
    "verificationCount",
    "matchedCount",
    "mismatchedCount",
    "failedCount",
    "scannedPackageCount",
    "setPackageCount",
    "missingFromSetCount",
    "extraInSetCount",
    "verifications",
    "diagnosticCounts",
    "diagnosticCodeCounts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "batchPath": {
      "type": "string"
    },
    "success": {
      "type": "boolean"
    },
    "matches": {
      "type": "boolean"
    },
    "releaseEligible": {
      "type": "boolean"
    },
    "verificationCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "matchedCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "mismatchedCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "failedCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "scannedPackageCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "setPackageCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "missingFromSetCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "extraInSetCount": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "verifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationSummary"
      }
    },
    "diagnosticCounts": {
      "$ref": "#/$defs/diagnosticCounts"
    },
    "diagnosticCodeCounts": {
      "$ref": "#/$defs/diagnosticCodeCounts"
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "pathList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "warning",
        "error"
      ],
      "properties": {
        "note": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnosticCodeCounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnosticCodeCount"
      }
    },
    "diagnosticCodeCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "count"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "verificationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootPath",
        "setPath",
        "success",
        "matches",
        "scannedPackageCount",
        "setPackageCount",
        "missingFromSetCount",
        "extraInSetCount",
        "missingFromSet",
        "extraInSet",
        "diagnosticCounts",
        "diagnosticCodeCounts"
      ],
      "properties": {
        "rootPath": {
          "type": "string"
        },
        "setPath": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "matches": {
          "type": "boolean"
        },
        "scannedPackageCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "setPackageCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "missingFromSetCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "extraInSetCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "missingFromSet": {
          "$ref": "#/$defs/pathList"
        },
        "extraInSet": {
          "$ref": "#/$defs/pathList"
        },
        "diagnosticCounts": {
          "$ref": "#/$defs/diagnosticCounts"
        },
        "diagnosticCodeCounts": {
          "$ref": "#/$defs/diagnosticCodeCounts"
        }
      }
    }
  }
}
