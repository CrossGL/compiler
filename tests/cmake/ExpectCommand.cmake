function(crossgl_write_fake_path_tool directory name)
  set(tool_path "${directory}/${name}")
  if(DEFINED FAKE_TOOLCHAIN_VERSION_MODE)
    set(version_mode "${FAKE_TOOLCHAIN_VERSION_MODE}")
  else()
    set(version_mode "captured")
  endif()
  if(WIN32)
    if(version_mode STREQUAL "failed")
      file(WRITE "${tool_path}.cmd"
           "@echo off\r\n"
           "if \"%1\" == \"--version\" echo fake ${name} probe failed 1>&2\r\n"
           "if \"%1\" == \"--version\" exit /b 2\r\n"
           "exit /b 0\r\n")
    elseif(version_mode STREQUAL "unknown")
      file(WRITE "${tool_path}.cmd"
           "@echo off\r\n"
           "exit /b 0\r\n")
    else()
      file(WRITE "${tool_path}.cmd"
           "@echo off\r\n"
           "if \"%1\" == \"--version\" echo fake ${name} 1.0\r\n"
           "exit /b 0\r\n")
    endif()
  else()
    if(version_mode STREQUAL "failed")
      file(WRITE "${tool_path}"
           "#!/bin/sh\n"
           "if [ \"$1\" = \"--version\" ]; then\n"
           "  printf 'fake ${name} probe failed\\n' >&2\n"
           "  exit 2\n"
           "fi\n"
           "exit 0\n")
    elseif(version_mode STREQUAL "unknown")
      file(WRITE "${tool_path}"
           "#!/bin/sh\n"
           "exit 0\n")
    else()
      file(WRITE "${tool_path}"
           "#!/bin/sh\n"
           "if [ \"$1\" = \"--version\" ]; then\n"
           "  printf 'fake ${name} 1.0\\n'\n"
           "fi\n"
           "exit 0\n")
    endif()
    file(CHMOD "${tool_path}"
         PERMISSIONS
           OWNER_READ OWNER_WRITE OWNER_EXECUTE
           GROUP_READ GROUP_EXECUTE
           WORLD_READ WORLD_EXECUTE)
  endif()
endfunction()

function(crossgl_write_fake_xcrun directory)
  set(tool_path "${directory}/xcrun")
  if(WIN32)
    file(WRITE "${tool_path}" "fake xcrun\n")
    return()
  endif()
  if(DEFINED FAKE_TOOLCHAIN_VERSION_MODE)
    set(version_mode "${FAKE_TOOLCHAIN_VERSION_MODE}")
  else()
    set(version_mode "captured")
  endif()
  foreach(fake_metal_tool IN ITEMS metal metallib)
    if(version_mode STREQUAL "failed")
      file(WRITE "${directory}/${fake_metal_tool}"
           "#!/bin/sh\n"
           "if [ \"$1\" = \"--version\" ]; then\n"
           "  printf 'fake ${fake_metal_tool} probe failed\\n' >&2\n"
           "  exit 2\n"
           "fi\n"
           "exit 0\n")
    elseif(version_mode STREQUAL "unknown")
      file(WRITE "${directory}/${fake_metal_tool}"
           "#!/bin/sh\n"
           "exit 0\n")
    else()
      file(WRITE "${directory}/${fake_metal_tool}"
           "#!/bin/sh\n"
           "if [ \"$1\" = \"--version\" ]; then\n"
           "  printf 'fake ${fake_metal_tool} 1.0\\n'\n"
           "fi\n"
           "exit 0\n")
    endif()
    file(CHMOD "${directory}/${fake_metal_tool}"
         PERMISSIONS
           OWNER_READ OWNER_WRITE OWNER_EXECUTE
           GROUP_READ GROUP_EXECUTE
           WORLD_READ WORLD_EXECUTE)
  endforeach()
  file(WRITE "${tool_path}"
       "#!/bin/sh\n"
       "if [ \"$1\" = \"-find\" ]; then\n"
       "  case \"$2\" in\n"
       "    metal|metallib)\n"
       "      printf '%s/%s\\n' '${directory}' \"$2\"\n"
       "      exit 0\n"
       "      ;;\n"
       "  esac\n"
       "fi\n"
       "exit 1\n")
  file(CHMOD "${tool_path}"
       PERMISSIONS
         OWNER_READ OWNER_WRITE OWNER_EXECUTE
         GROUP_READ GROUP_EXECUTE
         WORLD_READ WORLD_EXECUTE)
endfunction()

