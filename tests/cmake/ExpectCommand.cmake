function(crossgl_json_path_to_list path out_var)
  string(REPLACE "." ";" path_list "${path}")
  set(${out_var} ${path_list} PARENT_SCOPE)
endfunction()

function(crossgl_normalize_expected_json_value value out_var)
  if("${value}" STREQUAL "true")
    set(normalized ON)
  elseif("${value}" STREQUAL "false")
    set(normalized OFF)
  elseif("${value}" STREQUAL "null")
    set(normalized "")
  else()
    set(normalized "${value}")
  endif()
  set(${out_var} "${normalized}" PARENT_SCOPE)
endfunction()

function(crossgl_split_json_expectation expectation out_key out_value)
  string(FIND "${expectation}" "=" split_position)
  if(split_position EQUAL -1)
    message(FATAL_ERROR "expected JSON assertion '${expectation}' to use path=value")
  endif()
  string(SUBSTRING "${expectation}" 0 ${split_position} key)
  math(EXPR value_position "${split_position} + 1")
  string(SUBSTRING "${expectation}" ${value_position} -1 value)
  if("${key}" STREQUAL "")
    message(FATAL_ERROR "expected JSON assertion '${expectation}' to include a path")
  endif()
  set(${out_key} "${key}" PARENT_SCOPE)
  set(${out_value} "${value}" PARENT_SCOPE)
endfunction()

function(crossgl_expect_json_field json path expected)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON actual ERROR_VARIABLE json_error GET "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON field '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
  crossgl_normalize_expected_json_value("${expected}" normalized_expected)
  if(NOT actual STREQUAL "${normalized_expected}")
    message(FATAL_ERROR "expected JSON field '${path}' to equal '${expected}', got '${actual}'. Output: ${json}")
  endif()
endfunction()

function(crossgl_expect_json_field_one_of json path expected_values)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON actual ERROR_VARIABLE json_error GET "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON field '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
  string(REPLACE "," ";" expected_value_list "${expected_values}")
  foreach(expected IN LISTS expected_value_list)
    crossgl_normalize_expected_json_value("${expected}" normalized_expected)
    if(actual STREQUAL "${normalized_expected}")
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "expected JSON field '${path}' to equal one of '${expected_values}', got '${actual}'. Output: ${json}")
endfunction()

function(crossgl_expect_json_field_contains json path expected_fragment)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON actual ERROR_VARIABLE json_error GET "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON field '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
  string(FIND "${actual}" "${expected_fragment}" fragment_position)
  if(fragment_position EQUAL -1)
    message(FATAL_ERROR "expected JSON field '${path}' to contain '${expected_fragment}', got '${actual}'. Output: ${json}")
  endif()
endfunction()

function(crossgl_expect_json_field_greater_than json path minimum)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON actual ERROR_VARIABLE json_error GET "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON field '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
  if(NOT "${minimum}" MATCHES "^-?[0-9]+$")
    message(FATAL_ERROR "expected JSON field '${path}' minimum to be an integer, got '${minimum}'")
  endif()
  if(NOT "${actual}" MATCHES "^-?[0-9]+$")
    message(FATAL_ERROR "expected JSON field '${path}' to be an integer greater than '${minimum}', got '${actual}'. Output: ${json}")
  endif()
  if(NOT "${actual}" GREATER "${minimum}")
    message(FATAL_ERROR "expected JSON field '${path}' to be greater than '${minimum}', got '${actual}'. Output: ${json}")
  endif()
endfunction()

function(crossgl_expect_json_path_exists json path)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON actual ERROR_VARIABLE json_error GET "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON path '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
endfunction()

function(crossgl_expect_json_unsigned_number json path)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON actual_type ERROR_VARIABLE type_error TYPE "${json}" ${json_path})
  if(NOT type_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON number '${path}', but type lookup failed: ${type_error}. Output: ${json}")
  endif()
  if(NOT actual_type STREQUAL "NUMBER")
    message(FATAL_ERROR "expected JSON path '${path}' to be a number, got '${actual_type}'. Output: ${json}")
  endif()
  string(JSON actual ERROR_VARIABLE json_error GET "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON number '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
  if(NOT actual MATCHES "^[0-9]+$")
    message(FATAL_ERROR "expected JSON path '${path}' to be an unsigned integer, got '${actual}'. Output: ${json}")
  endif()
endfunction()

function(crossgl_expect_json_path_absent json path)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON actual ERROR_VARIABLE json_error GET "${json}" ${json_path})
  if(json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON path '${path}' to be absent, but it was present. Output: ${json}")
  endif()
endfunction()

function(crossgl_expect_json_array_contains json path expected)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON array_length ERROR_VARIABLE json_error LENGTH "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON array '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
  if(array_length EQUAL 0)
    message(FATAL_ERROR "expected JSON array '${path}' to contain '${expected}', but it was empty. Output: ${json}")
  endif()
  crossgl_normalize_expected_json_value("${expected}" normalized_expected)
  math(EXPR last_index "${array_length} - 1")
  foreach(index RANGE 0 ${last_index})
    string(JSON actual ERROR_VARIABLE item_error GET "${json}" ${json_path} ${index})
    if(NOT item_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "failed to read JSON array '${path}' item ${index}: ${item_error}. Output: ${json}")
    endif()
    if(actual STREQUAL "${normalized_expected}")
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "expected JSON array '${path}' to contain '${expected}'. Output: ${json}")
endfunction()

function(crossgl_expect_json_array_length json path expected)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON array_length ERROR_VARIABLE json_error LENGTH "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON array '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
  if(NOT array_length STREQUAL "${expected}")
    message(FATAL_ERROR "expected JSON array '${path}' to have length '${expected}', got '${array_length}'. Output: ${json}")
  endif()
endfunction()

function(crossgl_expect_hir_pass_trace_metrics json)
  string(JSON pass_count ERROR_VARIABLE json_error LENGTH "${json}" passes)
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected HIR pass trace passes array, but lookup failed: ${json_error}. Output: ${json}")
  endif()
  if(pass_count EQUAL 0)
    message(FATAL_ERROR "expected HIR pass trace to contain at least one pass. Output: ${json}")
  endif()

  foreach(field IN ITEMS
      scheduledPassCount
      passCount
      changedPassCount
      diagnosticPassCount
      errorPassCount)
    crossgl_expect_json_unsigned_number("${json}" "${field}")
  endforeach()
  crossgl_expect_json_path_exists("${json}" "changed")
  crossgl_expect_json_path_exists("${json}" "completed")
  crossgl_expect_json_path_exists("${json}" "stopReason")

  string(JSON trace_scheduled_pass_count GET "${json}" scheduledPassCount)
  string(JSON trace_pass_count GET "${json}" passCount)
  string(JSON trace_changed_pass_count GET "${json}" changedPassCount)
  string(JSON trace_diagnostic_pass_count GET "${json}" diagnosticPassCount)
  string(JSON trace_error_pass_count GET "${json}" errorPassCount)
  string(JSON trace_changed GET "${json}" changed)
  string(JSON trace_completed GET "${json}" completed)
  string(JSON trace_stop_reason GET "${json}" stopReason)

  if(NOT trace_pass_count STREQUAL "${pass_count}")
    message(FATAL_ERROR "expected HIR pass trace passCount to equal passes length ${pass_count}, got ${trace_pass_count}. Output: ${json}")
  endif()
  if(trace_scheduled_pass_count LESS pass_count)
    message(FATAL_ERROR "expected HIR pass trace scheduledPassCount ${trace_scheduled_pass_count} to be at least passCount ${pass_count}. Output: ${json}")
  endif()
  if(trace_completed)
    if(NOT trace_scheduled_pass_count STREQUAL "${pass_count}")
      message(FATAL_ERROR "expected completed HIR pass trace scheduledPassCount to equal passCount ${pass_count}, got ${trace_scheduled_pass_count}. Output: ${json}")
    endif()
    if(NOT trace_stop_reason STREQUAL "none")
      message(FATAL_ERROR "expected completed HIR pass trace stopReason to be 'none', got '${trace_stop_reason}'. Output: ${json}")
    endif()
  endif()

  set(stats_groups before after delta)
  set(stats_fields
    structCount
    constantCount
    stageCount
    resourceCount
    functionCount
    statementCount
    expressionCount)
  set(actual_changed OFF)
  set(actual_changed_pass_count 0)
  set(actual_diagnostic_pass_count 0)
  set(actual_error_pass_count 0)
  math(EXPR last_index "${pass_count} - 1")
  foreach(index RANGE 0 ${last_index})
    crossgl_expect_json_unsigned_number("${json}" "passes.${index}.index")
    crossgl_expect_json_field("${json}" "passes.${index}.index" "${index}")
    crossgl_expect_json_path_exists("${json}" "passes.${index}.id")
    crossgl_expect_json_path_exists("${json}" "passes.${index}.name")
    crossgl_expect_json_path_exists("${json}" "passes.${index}.category")
    crossgl_expect_json_unsigned_number("${json}" "passes.${index}.diagnosticCount")
    crossgl_expect_json_unsigned_number("${json}" "passes.${index}.errorCount")
    crossgl_expect_json_unsigned_number(
      "${json}" "passes.${index}.elapsedTimeMicroseconds")

    string(JSON pass_id GET "${json}" passes ${index} id)
    string(JSON pass_name GET "${json}" passes ${index} name)
    string(JSON pass_category GET "${json}" passes ${index} category)
    string(JSON pass_changed GET "${json}" passes ${index} changed)
    string(JSON pass_status GET "${json}" passes ${index} status)
    string(JSON pass_diagnostic_count GET "${json}" passes ${index}
           diagnosticCount)
    string(JSON pass_error_count GET "${json}" passes ${index} errorCount)
    if("${pass_id}" STREQUAL "")
      message(FATAL_ERROR "expected HIR pass trace pass ${index} to have a nonempty id. Output: ${json}")
    endif()
    if("${pass_name}" STREQUAL "")
      message(FATAL_ERROR "expected HIR pass trace pass ${index} to have a nonempty name. Output: ${json}")
    endif()
    if(NOT "${pass_id}" MATCHES "^[a-z0-9]+([.][a-z0-9-]+)*$")
      message(FATAL_ERROR "expected HIR pass trace pass ${index} id '${pass_id}' to be a stable dotted identifier. Output: ${json}")
    endif()
    if(NOT "${pass_category}" MATCHES "^(validation|optimization|cleanup|custom)$")
      message(FATAL_ERROR "expected HIR pass trace pass ${index} category '${pass_category}' to be validation, optimization, cleanup, or custom. Output: ${json}")
    endif()
    if("${pass_id}" MATCHES "^hir[.]validate[.]" AND NOT "${pass_category}" STREQUAL "validation")
      message(FATAL_ERROR "expected HIR validation pass ${index} '${pass_id}' to have validation category, got '${pass_category}'. Output: ${json}")
    endif()
    if("${pass_id}" MATCHES "^hir[.]optimize[.]cleanup-" AND NOT "${pass_category}" STREQUAL "cleanup")
      message(FATAL_ERROR "expected HIR cleanup pass ${index} '${pass_id}' to have cleanup category, got '${pass_category}'. Output: ${json}")
    endif()
    if("${pass_id}" MATCHES "^hir[.]optimize[.]" AND
       NOT "${pass_id}" MATCHES "^hir[.]optimize[.]cleanup-" AND
       NOT "${pass_category}" STREQUAL "optimization")
      message(FATAL_ERROR "expected HIR optimization pass ${index} '${pass_id}' to have optimization category, got '${pass_category}'. Output: ${json}")
    endif()
    if(pass_error_count GREATER pass_diagnostic_count)
      message(FATAL_ERROR "expected HIR pass trace pass ${index} errorCount ${pass_error_count} to be no greater than diagnosticCount ${pass_diagnostic_count}. Output: ${json}")
    endif()
    if(pass_changed)
      set(actual_changed ON)
      math(EXPR actual_changed_pass_count "${actual_changed_pass_count} + 1")
    endif()
    if(pass_diagnostic_count GREATER 0)
      math(EXPR actual_diagnostic_pass_count "${actual_diagnostic_pass_count} + 1")
    endif()
    if(pass_error_count GREATER 0)
      math(EXPR actual_error_pass_count "${actual_error_pass_count} + 1")
      if(NOT pass_status STREQUAL "failed")
        message(FATAL_ERROR "expected HIR pass trace pass ${index} with errors to have failed status, got '${pass_status}'. Output: ${json}")
      endif()
    elseif(NOT pass_status STREQUAL "completed")
      message(FATAL_ERROR "expected HIR pass trace pass ${index} without errors to have completed status, got '${pass_status}'. Output: ${json}")
    endif()

    foreach(group IN LISTS stats_groups)
      foreach(field IN LISTS stats_fields)
        crossgl_expect_json_unsigned_number(
          "${json}" "passes.${index}.moduleStats.${group}.${field}")
      endforeach()
    endforeach()
    foreach(field IN LISTS stats_fields)
      string(JSON before_value GET "${json}" passes ${index} moduleStats
             before ${field})
      string(JSON after_value GET "${json}" passes ${index} moduleStats after
             ${field})
      string(JSON delta_value GET "${json}" passes ${index} moduleStats delta
             ${field})
      if(after_value GREATER before_value)
        math(EXPR expected_delta "${after_value} - ${before_value}")
      else()
        math(EXPR expected_delta "${before_value} - ${after_value}")
      endif()
      if(NOT delta_value STREQUAL "${expected_delta}")
        message(FATAL_ERROR "expected HIR pass trace pass ${index} moduleStats.delta.${field} to equal |after-before| ${expected_delta}, got ${delta_value}. Output: ${json}")
      endif()
      if(NOT pass_changed AND NOT delta_value STREQUAL "0")
        message(FATAL_ERROR "expected unchanged HIR pass trace pass ${index} moduleStats.delta.${field} to be 0, got ${delta_value}. Output: ${json}")
      endif()
    endforeach()
  endforeach()

  if(NOT trace_changed STREQUAL "${actual_changed}")
    message(FATAL_ERROR "expected HIR pass trace changed to equal per-pass changed OR '${actual_changed}', got '${trace_changed}'. Output: ${json}")
  endif()
  if(NOT trace_changed_pass_count STREQUAL "${actual_changed_pass_count}")
    message(FATAL_ERROR "expected HIR pass trace changedPassCount to equal ${actual_changed_pass_count}, got ${trace_changed_pass_count}. Output: ${json}")
  endif()
  if(NOT trace_diagnostic_pass_count STREQUAL "${actual_diagnostic_pass_count}")
    message(FATAL_ERROR "expected HIR pass trace diagnosticPassCount to equal ${actual_diagnostic_pass_count}, got ${trace_diagnostic_pass_count}. Output: ${json}")
  endif()
  if(NOT trace_error_pass_count STREQUAL "${actual_error_pass_count}")
    message(FATAL_ERROR "expected HIR pass trace errorPassCount to equal ${actual_error_pass_count}, got ${trace_error_pass_count}. Output: ${json}")
  endif()
endfunction()

function(crossgl_run_json_literal_self_test)
  set(manifest "variable value that must not replace the expected literal")
  set(json "{\"rootFiles\":[{\"name\":\"manifest\",\"exists\":true}],\"values\":{\"enabled\":true,\"disabled\":false,\"missing\":null,\"count\":7}}")
  crossgl_expect_json_field("${json}" "rootFiles.0.name" "manifest")
  crossgl_expect_json_field("${json}" "rootFiles.0.exists" "true")
  crossgl_expect_json_field("${json}" "values.enabled" "true")
  crossgl_expect_json_field("${json}" "values.disabled" "false")
  crossgl_expect_json_field("${json}" "values.missing" "null")
  crossgl_expect_json_field("${json}" "values.count" "7")
endfunction()

function(crossgl_expect_auto_target_decision_from_capabilities json)
  crossgl_expect_json_field("${json}" "targetDecision.requestedTarget" "auto")

  string(JSON default_target ERROR_VARIABLE default_error GET "${json}"
         targetCapabilities defaultTarget)
  if(NOT default_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON field 'targetCapabilities.defaultTarget', but lookup failed: ${default_error}. Output: ${json}")
  endif()

  string(JSON summary_count ERROR_VARIABLE summaries_error LENGTH "${json}"
         targetCapabilities summaries)
  if(NOT summaries_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON target array 'targetCapabilities.summaries', but lookup failed: ${summaries_error}. Output: ${json}")
  endif()

  set(selected_target "")
  set(selected_rank "")
  set(selected_buildable OFF)
  set(viable_target_count 0)
  if(summary_count GREATER 0)
    math(EXPR last_summary_index "${summary_count} - 1")
    foreach(index RANGE 0 ${last_summary_index})
      string(JSON summary_target ERROR_VARIABLE target_error GET "${json}"
             targetCapabilities summaries ${index} target)
      if(NOT target_error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "failed to read target capability summary ${index} target: ${target_error}. Output: ${json}")
      endif()
      string(JSON package_supported ERROR_VARIABLE supported_error GET
             "${json}" targetCapabilities summaries ${index}
             packageBuildSupported)
      if(NOT supported_error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "failed to read target capability summary ${index} packageBuildSupported: ${supported_error}. Output: ${json}")
      endif()
      string(JSON rank_score ERROR_VARIABLE rank_error GET "${json}"
             targetCapabilities summaries ${index} packageRankScore)
      if(NOT rank_error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "failed to read target capability summary ${index} packageRankScore: ${rank_error}. Output: ${json}")
      endif()

      if(package_supported)
        math(EXPR viable_target_count "${viable_target_count} + 1")
        set(should_select OFF)
        if("${selected_target}" STREQUAL "")
          set(should_select ON)
        elseif(rank_score LESS selected_rank)
          set(should_select ON)
        elseif(rank_score EQUAL selected_rank AND
               "${summary_target}" STREQUAL "${default_target}" AND
               NOT "${selected_target}" STREQUAL "${default_target}")
          set(should_select ON)
        endif()

        if(should_select)
          set(selected_target "${summary_target}")
          set(selected_rank "${rank_score}")
          set(selected_buildable ON)
        endif()
      endif()
    endforeach()
  endif()

  if("${selected_target}" STREQUAL "")
    set(selected_target "${default_target}")
  endif()
  if("${selected_target}" STREQUAL "${default_target}")
    set(selection_reason "auto-host-default")
  else()
    set(selection_reason "auto-recommended-target")
  endif()
  set(expected_fallback_count "${viable_target_count}")
  if(selected_buildable AND viable_target_count GREATER 0)
    math(EXPR expected_fallback_count "${viable_target_count} - 1")
  endif()

  crossgl_expect_json_field("${json}" "targetDecision.selectedTarget"
                            "${selected_target}")
  crossgl_expect_json_field("${json}" "targetDecision.selectionReason"
                            "${selection_reason}")
  crossgl_expect_json_field("${json}"
                            "targetDecision.fallbackTargetRecordCount"
                            "${expected_fallback_count}")
  crossgl_expect_json_array_length("${json}" "targetDecision.viableTargets"
                                   "${viable_target_count}")
  crossgl_expect_json_array_length("${json}" "targetDecision.fallbackTargets"
                                   "${expected_fallback_count}")
  crossgl_expect_json_array_length("${json}"
                                   "targetDecision.fallbackTargetRecords"
                                   "${expected_fallback_count}")
  if(selected_buildable)
    crossgl_expect_json_array_contains("${json}" "targetDecision.viableTargets"
                                       "${selected_target}")
  endif()
endfunction()

function(crossgl_expect_json_object_member_order json path expected_order)
  crossgl_json_path_to_list("${path}" json_path)
  string(JSON member_count ERROR_VARIABLE json_error LENGTH "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON object '${path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()

  string(REPLACE "," ";" expected_members "${expected_order}")
  list(LENGTH expected_members expected_count)
  if(NOT member_count EQUAL expected_count)
    string(REPLACE ";" "," expected_display "${expected_members}")
    message(FATAL_ERROR "expected JSON object '${path}' member order '${expected_display}', got ${member_count} member(s). Output: ${json}")
  endif()

  string(REPLACE "." ";" path_members "${path}")
  list(GET path_members -1 object_member)
  string(FIND "${json}" "\"${object_member}\":" object_position)
  if(object_position EQUAL -1)
    message(FATAL_ERROR "expected JSON object '${path}' in source text. Output: ${json}")
  endif()

  set(search_position "${object_position}")
  foreach(member IN LISTS expected_members)
    crossgl_expect_json_path_exists("${json}" "${path}.${member}")
    string(SUBSTRING "${json}" ${search_position} -1 remaining_json)
    string(FIND "${remaining_json}" "\"${member}\":" member_position)
    if(member_position EQUAL -1)
      string(REPLACE ";" "," expected_display "${expected_members}")
      message(FATAL_ERROR "expected JSON object '${path}' member order '${expected_display}', but '${member}' did not appear after the prior expected member. Output: ${json}")
    endif()
    math(EXPR search_position "${search_position} + ${member_position} + 1")
  endforeach()
endfunction()

function(crossgl_find_target_record_index json root array_field key_field key
         out_var)
  if("${root}" STREQUAL "")
    set(targets_path "${array_field}")
  else()
    set(targets_path "${root}.${array_field}")
  endif()
  crossgl_json_path_to_list("${targets_path}" json_path)
  string(JSON target_count ERROR_VARIABLE json_error LENGTH "${json}" ${json_path})
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "expected JSON target array '${targets_path}', but lookup failed: ${json_error}. Output: ${json}")
  endif()
  if(target_count EQUAL 0)
    message(FATAL_ERROR "expected JSON record array '${targets_path}' to contain ${key_field} '${key}'. Output: ${json}")
  endif()
  math(EXPR last_index "${target_count} - 1")
  foreach(index RANGE 0 ${last_index})
    string(JSON record_key ERROR_VARIABLE item_error GET "${json}" ${json_path} ${index} ${key_field})
    if(NOT item_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "failed to read JSON record ${index} key ${key_field}: ${item_error}. Output: ${json}")
    endif()
    if(record_key STREQUAL "${key}")
      set(${out_var} "${index}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "expected JSON record array '${targets_path}' to contain ${key_field} '${key}'. Output: ${json}")
endfunction()

function(crossgl_split_target_expectation expectation out_target out_field out_value)
  crossgl_split_json_expectation("${expectation}" key value)
  string(FIND "${key}" "." split_position)
  if(split_position EQUAL -1)
    message(FATAL_ERROR "expected target JSON assertion '${expectation}' to use target.field=value")
  endif()
  string(SUBSTRING "${key}" 0 ${split_position} target)
  math(EXPR field_position "${split_position} + 1")
  string(SUBSTRING "${key}" ${field_position} -1 field)
  if("${target}" STREQUAL "" OR "${field}" STREQUAL "")
    message(FATAL_ERROR "expected target JSON assertion '${expectation}' to use target.field=value")
  endif()
  set(${out_target} "${target}" PARENT_SCOPE)
  set(${out_field} "${field}" PARENT_SCOPE)
  set(${out_value} "${value}" PARENT_SCOPE)
endfunction()

function(crossgl_expect_target_json_field json root array_field key_field target
         field expected)
  crossgl_find_target_record_index("${json}" "${root}" "${array_field}"
                                   "${key_field}" "${target}" target_index)
  if("${root}" STREQUAL "")
    set(path "${array_field}.${target_index}.${field}")
  else()
    set(path "${root}.${array_field}.${target_index}.${field}")
  endif()
  crossgl_expect_json_field("${json}" "${path}" "${expected}")
endfunction()

function(crossgl_expect_target_json_array_contains json root array_field
         key_field target field expected)
  crossgl_find_target_record_index("${json}" "${root}" "${array_field}"
                                   "${key_field}" "${target}" target_index)
  if("${root}" STREQUAL "")
    set(path "${array_field}.${target_index}.${field}")
  else()
    set(path "${root}.${array_field}.${target_index}.${field}")
  endif()
  crossgl_expect_json_array_contains("${json}" "${path}" "${expected}")
endfunction()

function(crossgl_apply_json_expectations json)
  if(AUTO_TARGET_DECISION_FROM_CAPABILITIES)
    crossgl_expect_auto_target_decision_from_capabilities("${json}")
  endif()

  if(DEFINED EXPECTED_JSON_PATHS)
    string(REPLACE "|" ";" json_paths "${EXPECTED_JSON_PATHS}")
    foreach(path IN LISTS json_paths)
      crossgl_expect_json_path_exists("${json}" "${path}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_JSON_UNSIGNED_PATHS)
    string(REPLACE "|" ";" json_unsigned_paths "${EXPECTED_JSON_UNSIGNED_PATHS}")
    foreach(path IN LISTS json_unsigned_paths)
      crossgl_expect_json_unsigned_number("${json}" "${path}")
    endforeach()
  endif()

  if(DEFINED EXPECT_HIR_PASS_TRACE_METRICS AND EXPECT_HIR_PASS_TRACE_METRICS)
    crossgl_expect_hir_pass_trace_metrics("${json}")
  endif()

  if(DEFINED EXPECTED_JSON_FIELDS)
    string(REPLACE "|" ";" json_expectations "${EXPECTED_JSON_FIELDS}")
    foreach(expectation IN LISTS json_expectations)
      crossgl_split_json_expectation("${expectation}" path expected)
      crossgl_expect_json_field("${json}" "${path}" "${expected}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_JSON_FIELD_ONE_OF)
    string(REPLACE "|" ";" json_one_of_expectations
           "${EXPECTED_JSON_FIELD_ONE_OF}")
    foreach(expectation IN LISTS json_one_of_expectations)
      crossgl_split_json_expectation("${expectation}" path expected_values)
      crossgl_expect_json_field_one_of("${json}" "${path}" "${expected_values}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_JSON_ARRAY_CONTAINS)
    string(REPLACE "|" ";" json_array_expectations "${EXPECTED_JSON_ARRAY_CONTAINS}")
    foreach(expectation IN LISTS json_array_expectations)
      crossgl_split_json_expectation("${expectation}" path expected)
      crossgl_expect_json_array_contains("${json}" "${path}" "${expected}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_JSON_ARRAY_LENGTHS)
    string(REPLACE "|" ";" json_array_length_expectations
           "${EXPECTED_JSON_ARRAY_LENGTHS}")
    foreach(expectation IN LISTS json_array_length_expectations)
      crossgl_split_json_expectation("${expectation}" path expected)
      crossgl_expect_json_array_length("${json}" "${path}" "${expected}")
    endforeach()
  endif()

  if(DEFINED TARGET_EXPLANATION_ROOT)
    set(target_root "${TARGET_EXPLANATION_ROOT}")
  else()
    set(target_root "")
  endif()
  if(DEFINED TARGET_RECORD_ARRAY_FIELD)
    set(target_array_field "${TARGET_RECORD_ARRAY_FIELD}")
  else()
    set(target_array_field "targets")
  endif()
  if(DEFINED TARGET_RECORD_KEY_FIELD)
    set(target_key_field "${TARGET_RECORD_KEY_FIELD}")
  else()
    set(target_key_field "target")
  endif()

  if(DEFINED EXPECTED_TARGET_FIELDS)
    string(REPLACE "|" ";" target_expectations "${EXPECTED_TARGET_FIELDS}")
    foreach(expectation IN LISTS target_expectations)
      crossgl_split_target_expectation("${expectation}" target field expected)
      crossgl_expect_target_json_field("${json}" "${target_root}" "${target_array_field}" "${target_key_field}" "${target}" "${field}" "${expected}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_TARGET_ARRAY_CONTAINS)
    string(REPLACE "|" ";" target_array_expectations "${EXPECTED_TARGET_ARRAY_CONTAINS}")
    foreach(expectation IN LISTS target_array_expectations)
      crossgl_split_target_expectation("${expectation}" target field expected)
      crossgl_expect_target_json_array_contains("${json}" "${target_root}" "${target_array_field}" "${target_key_field}" "${target}" "${field}" "${expected}")
    endforeach()
  endif()
endfunction()

function(crossgl_validate_json_schema_file json schema_path)
  if("${schema_path}" STREQUAL "")
    return()
  endif()
  if(NOT DEFINED JSON_SCHEMA_VALIDATOR)
    message(FATAL_ERROR "JSON_SCHEMA_VALIDATOR is required when schema validation is enabled")
  endif()
  if(NOT DEFINED PYTHON3_EXECUTABLE)
    message(FATAL_ERROR "PYTHON3_EXECUTABLE is required when schema validation is enabled")
  endif()

  string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef schema_nonce)
  set(instance_path
      "${CMAKE_CURRENT_BINARY_DIR}/crossgl-schema-instance-${MODE}-${schema_nonce}.json")
  file(WRITE "${instance_path}" "${json}")
  execute_process(
    COMMAND "${PYTHON3_EXECUTABLE}" "${JSON_SCHEMA_VALIDATOR}"
            --schema "${schema_path}"
            --instance "${instance_path}"
    RESULT_VARIABLE schema_result
    OUTPUT_VARIABLE schema_stdout
    ERROR_VARIABLE schema_stderr
  )
  if(NOT schema_result EQUAL 0)
    message(FATAL_ERROR "JSON schema validation failed: ${schema_stderr}${schema_stdout}")
  endif()
endfunction()

function(crossgl_validate_json_schema json)
  if(NOT DEFINED JSON_SCHEMA)
    return()
  endif()
  crossgl_validate_json_schema_file("${json}" "${JSON_SCHEMA}")
endfunction()

function(crossgl_mutate_package_manifest package_path mutation_kind)
  if("${mutation_kind}" STREQUAL "")
    return()
  endif()

  set(manifest_path "${package_path}/manifest.json")
  if(NOT EXISTS "${manifest_path}")
    message(FATAL_ERROR
      "cannot mutate package manifest; file does not exist: ${manifest_path}")
  endif()

  file(READ "${manifest_path}" manifest)
  if(mutation_kind STREQUAL "remove-package-artifact-requirements")
    string(JSON mutated_manifest ERROR_VARIABLE manifest_error
      REMOVE "${manifest}" packageArtifactRequirements)
    if(manifest_error STREQUAL "NOTFOUND")
      string(JSON mutated_manifest ERROR_VARIABLE manifest_error
        REMOVE "${mutated_manifest}" targetLegalizationToolRequirements)
    endif()
  elseif(mutation_kind STREQUAL "null-package-artifact-requirements")
    string(JSON mutated_manifest ERROR_VARIABLE manifest_error
      SET "${manifest}" packageArtifactRequirements "null")
  elseif(mutation_kind STREQUAL
         "empty-package-artifact-requirements-required-path-artifacts")
    string(JSON mutated_manifest ERROR_VARIABLE manifest_error
      SET "${manifest}" packageArtifactRequirements requiredPathArtifacts "[]")
  elseif(mutation_kind STREQUAL
         "conflicting-package-artifact-requirements-required-path-artifacts")
    string(JSON mutated_manifest ERROR_VARIABLE manifest_error
      SET "${manifest}" packageArtifactRequirements requiredPathArtifacts
      "[\"backendAssembly\",\"nativeBinary\"]")
    if(manifest_error STREQUAL "NOTFOUND")
      string(JSON mutated_manifest ERROR_VARIABLE manifest_error
        SET "${mutated_manifest}" packageArtifactRequirements evidenceIds
        "[\"target-legalization.v1.directx.package-artifacts.source-package\",\"target-legalization.v1.directx.package-artifact.required.backendAssembly\",\"target-legalization.v1.directx.package-artifact.required.nativeBinary\",\"target-legalization.v1.directx.package-artifact.native-binary-status.required\",\"target-legalization.v1.directx.package-artifact.planned-native-binary.allowed\",\"target-legalization.v1.directx.package-artifact.planned-native-source-evidence.allowed\"]")
    endif()
  else()
    message(FATAL_ERROR "unknown MANIFEST_MUTATION_KIND: ${mutation_kind}")
  endif()

  if(NOT manifest_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR
      "failed to mutate package manifest for ${mutation_kind}: ${manifest_error}")
  endif()
  file(WRITE "${manifest_path}" "${mutated_manifest}")
endfunction()

function(crossgl_mutate_package_reflection package_path mutation_kind)
  if("${mutation_kind}" STREQUAL "")
    return()
  endif()

  set(manifest_path "${package_path}/manifest.json")
  set(reflection_path "${package_path}/reflection.json")
  if(NOT EXISTS "${manifest_path}")
    message(FATAL_ERROR
      "cannot mutate package reflection; manifest does not exist: ${manifest_path}")
  endif()
  if(NOT EXISTS "${reflection_path}")
    message(FATAL_ERROR
      "cannot mutate package reflection; file does not exist: ${reflection_path}")
  endif()

  file(READ "${manifest_path}" manifest)
  file(READ "${reflection_path}" reflection)
  if(mutation_kind STREQUAL "duplicate-selected-target-resource-binding")
    string(JSON selected_target ERROR_VARIABLE manifest_error GET
      "${manifest}" target)
    if(NOT manifest_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to read manifest target for ${mutation_kind}: ${manifest_error}")
    endif()
    string(JSON binding_count ERROR_VARIABLE reflection_error LENGTH
      "${reflection}" targetResourceBindings)
    if(NOT reflection_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to read reflection targetResourceBindings for ${mutation_kind}: ${reflection_error}")
    endif()
    if(binding_count LESS 1)
      message(FATAL_ERROR
        "cannot duplicate selected-target resource binding; reflection has no targetResourceBindings")
    endif()

    set(selected_binding_index -1)
    math(EXPR last_binding_index "${binding_count} - 1")
    foreach(binding_index RANGE 0 ${last_binding_index})
      string(JSON binding_target ERROR_VARIABLE target_error GET
        "${reflection}" targetResourceBindings ${binding_index} target)
      if(target_error STREQUAL "NOTFOUND" AND
         binding_target STREQUAL "${selected_target}")
        set(selected_binding_index ${binding_index})
        break()
      endif()
    endforeach()
    if(selected_binding_index EQUAL -1)
      message(FATAL_ERROR
        "cannot duplicate selected-target resource binding; no binding for ${selected_target}")
    endif()

    string(JSON duplicate_binding ERROR_VARIABLE reflection_error GET
      "${reflection}" targetResourceBindings ${selected_binding_index})
    if(NOT reflection_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to clone selected-target resource binding for ${mutation_kind}: ${reflection_error}")
    endif()
    string(JSON duplicate_binding ERROR_VARIABLE reflection_error SET
      "${duplicate_binding}" abi
      "{\"mutatedForDuplicateFixture\":true,\"space\":999,\"register\":\"u999\"}")
    if(NOT reflection_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to mutate duplicate resource binding ABI for ${mutation_kind}: ${reflection_error}")
    endif()
    string(JSON mutated_reflection ERROR_VARIABLE reflection_error SET
      "${reflection}" targetResourceBindings ${binding_count}
      "${duplicate_binding}")
  elseif(mutation_kind STREQUAL
         "selected-target-resource-binding-array-element-count-mismatch")
    string(JSON selected_target ERROR_VARIABLE manifest_error GET
      "${manifest}" target)
    if(NOT manifest_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to read manifest target for ${mutation_kind}: ${manifest_error}")
    endif()
    string(JSON binding_count ERROR_VARIABLE reflection_error LENGTH
      "${reflection}" targetResourceBindings)
    if(NOT reflection_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to read reflection targetResourceBindings for ${mutation_kind}: ${reflection_error}")
    endif()
    if(binding_count LESS 1)
      message(FATAL_ERROR
        "cannot mutate selected-target resource binding arrayElementCount; reflection has no targetResourceBindings")
    endif()

    set(selected_binding_index -1)
    set(selected_binding_array_element_count "")
    math(EXPR last_binding_index "${binding_count} - 1")
    foreach(binding_index RANGE 0 ${last_binding_index})
      string(JSON binding_target ERROR_VARIABLE target_error GET
        "${reflection}" targetResourceBindings ${binding_index} target)
      if(NOT target_error STREQUAL "NOTFOUND")
        continue()
      endif()
      if(NOT binding_target STREQUAL "${selected_target}")
        continue()
      endif()
      string(JSON array_element_count ERROR_VARIABLE count_error GET
        "${reflection}" targetResourceBindings ${binding_index}
        arrayElementCount)
      if(count_error STREQUAL "NOTFOUND")
        set(selected_binding_index ${binding_index})
        set(selected_binding_array_element_count ${array_element_count})
        break()
      endif()
    endforeach()
    if(selected_binding_index EQUAL -1)
      message(FATAL_ERROR
        "cannot mutate selected-target resource binding arrayElementCount; no selected-target binding has arrayElementCount")
    endif()

    math(EXPR mutated_array_element_count
      "${selected_binding_array_element_count} + 1")
    string(JSON mutated_reflection ERROR_VARIABLE reflection_error SET
      "${reflection}" targetResourceBindings ${selected_binding_index}
      arrayElementCount "${mutated_array_element_count}")
  elseif(mutation_kind STREQUAL
         "selected-target-resource-binding-array-element-count-missing")
    string(JSON selected_target ERROR_VARIABLE manifest_error GET
      "${manifest}" target)
    if(NOT manifest_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to read manifest target for ${mutation_kind}: ${manifest_error}")
    endif()
    string(JSON binding_count ERROR_VARIABLE reflection_error LENGTH
      "${reflection}" targetResourceBindings)
    if(NOT reflection_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to read reflection targetResourceBindings for ${mutation_kind}: ${reflection_error}")
    endif()
    if(binding_count LESS 1)
      message(FATAL_ERROR
        "cannot mutate selected-target resource binding arrayElementCount; reflection has no targetResourceBindings")
    endif()

    set(selected_binding_index -1)
    math(EXPR last_binding_index "${binding_count} - 1")
    foreach(binding_index RANGE 0 ${last_binding_index})
      string(JSON binding_target ERROR_VARIABLE target_error GET
        "${reflection}" targetResourceBindings ${binding_index} target)
      if(NOT target_error STREQUAL "NOTFOUND")
        continue()
      endif()
      if(NOT binding_target STREQUAL "${selected_target}")
        continue()
      endif()
      string(JSON array_element_count ERROR_VARIABLE count_error GET
        "${reflection}" targetResourceBindings ${binding_index}
        arrayElementCount)
      if(count_error STREQUAL "NOTFOUND")
        set(selected_binding_index ${binding_index})
        break()
      endif()
    endforeach()
    if(selected_binding_index EQUAL -1)
      message(FATAL_ERROR
        "cannot mutate selected-target resource binding arrayElementCount; no selected-target binding has arrayElementCount")
    endif()

    string(JSON mutated_reflection ERROR_VARIABLE reflection_error REMOVE
      "${reflection}" targetResourceBindings ${selected_binding_index}
      arrayElementCount)
  elseif(mutation_kind STREQUAL
         "selected-target-resource-binding-array-dimensions-mismatch")
    string(JSON selected_target ERROR_VARIABLE manifest_error GET
      "${manifest}" target)
    if(NOT manifest_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to read manifest target for ${mutation_kind}: ${manifest_error}")
    endif()
    string(JSON binding_count ERROR_VARIABLE reflection_error LENGTH
      "${reflection}" targetResourceBindings)
    if(NOT reflection_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR
        "failed to read reflection targetResourceBindings for ${mutation_kind}: ${reflection_error}")
    endif()
    if(binding_count LESS 1)
      message(FATAL_ERROR
        "cannot mutate selected-target resource binding arrayDimensions; reflection has no targetResourceBindings")
    endif()

    set(selected_binding_index -1)
    set(selected_binding_dimension_element_count "")
    math(EXPR last_binding_index "${binding_count} - 1")
    foreach(binding_index RANGE 0 ${last_binding_index})
      string(JSON binding_target ERROR_VARIABLE target_error GET
        "${reflection}" targetResourceBindings ${binding_index} target)
      if(NOT target_error STREQUAL "NOTFOUND")
        continue()
      endif()
      if(NOT binding_target STREQUAL "${selected_target}")
        continue()
      endif()
      string(JSON dimension_count ERROR_VARIABLE dimensions_error LENGTH
        "${reflection}" targetResourceBindings ${binding_index}
        arrayDimensions)
      if(NOT dimensions_error STREQUAL "NOTFOUND")
        continue()
      endif()
      if(NOT dimension_count GREATER 0)
        continue()
      endif()
      string(JSON dimension_element_count ERROR_VARIABLE element_count_error GET
        "${reflection}" targetResourceBindings ${binding_index}
        arrayDimensions 0 elementCount)
      if(NOT element_count_error STREQUAL "NOTFOUND")
        continue()
      endif()
      set(selected_binding_index ${binding_index})
      set(selected_binding_dimension_element_count ${dimension_element_count})
      break()
    endforeach()
    if(selected_binding_index EQUAL -1)
      message(FATAL_ERROR
        "cannot mutate selected-target resource binding arrayDimensions; no selected-target binding has arrayDimensions")
    endif()

    math(EXPR mutated_dimension_element_count
      "${selected_binding_dimension_element_count} + 1")
    string(JSON mutated_reflection ERROR_VARIABLE reflection_error SET
      "${reflection}" targetResourceBindings ${selected_binding_index}
      arrayDimensions 0 elementCount "${mutated_dimension_element_count}")
  else()
    message(FATAL_ERROR "unknown REFLECTION_MUTATION_KIND: ${mutation_kind}")
  endif()

  if(NOT reflection_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR
      "failed to mutate package reflection for ${mutation_kind}: ${reflection_error}")
  endif()
  file(WRITE "${reflection_path}" "${mutated_reflection}")
endfunction()

