    hirSourceMap expected_order_with_optional)
  string(JSON graphics_abi ERROR_VARIABLE graphics_abi_error GET
         "${manifest}" artifacts graphicsAbi)
  if(graphics_abi_error STREQUAL "NOTFOUND")
    string(FIND ",${expected_order_with_optional}," ",graphicsAbi,"
           graphics_abi_order_position)
    if(graphics_abi_order_position EQUAL -1)
      set(expected_order_with_optional
          "${expected_order_with_optional},graphicsAbi")
    endif()
  endif()
  crossgl_expect_json_object_member_order("${manifest}" "artifacts" "${expected_order_with_optional}")
endfunction()

function(crossgl_expect_graphics_abi_artifact manifest)
  string(JSON graphics_abi ERROR_VARIABLE graphics_abi_error GET
         "${manifest}" artifacts graphicsAbi)
  if(NOT graphics_abi_error STREQUAL "NOTFOUND")
    return()
  endif()
  crossgl_manifest_artifact_path("${manifest}" graphicsAbi graphics_abi_path)
  if(NOT EXISTS "${graphics_abi_path}")
    message(FATAL_ERROR "expected graphics ABI artifact at ${graphics_abi_path}")
  endif()
  if(DEFINED PYTHON3_EXECUTABLE AND NOT PYTHON3_EXECUTABLE STREQUAL "")
    set(graphics_abi_python "${PYTHON3_EXECUTABLE}")
  else()
    find_program(graphics_abi_python NAMES python3 python)
  endif()
  if(NOT graphics_abi_python)
    message(FATAL_ERROR "Python is required for graphics ABI verification")
  endif()
  execute_process(
    COMMAND "${graphics_abi_python}"
            "${CROSSGL_EXPECT_REPO_ROOT}/tools/verify_graphics_abi.py"
            --input "${graphics_abi_path}"
            --json
    RESULT_VARIABLE graphics_abi_result
    OUTPUT_VARIABLE graphics_abi_stdout
    ERROR_VARIABLE graphics_abi_stderr
  )
  if(NOT graphics_abi_result EQUAL 0)
    message(FATAL_ERROR "graphics ABI verifier failed: ${graphics_abi_stderr}${graphics_abi_stdout}")
  endif()
  crossgl_expect_json_field("${graphics_abi_stdout}" "success" "true")
  crossgl_expect_json_path_exists("${graphics_abi_stdout}" "resourceBindingEvidence")
  if(DEFINED JSON_SCHEMA_VALIDATOR)
    crossgl_validate_json_schema_file(
      "${graphics_abi_stdout}"
      "${CROSSGL_EXPECT_REPO_ROOT}/docs/schemas/graphics-abi-verify-v1.schema.json")
  endif()
endfunction()

