    endforeach()
  endif()

  if(DEFINED EXPECTED_DIAGNOSTICS_JSON_ARRAY_LENGTHS)
    string(REPLACE "|" ";" json_array_length_expectations
           "${EXPECTED_DIAGNOSTICS_JSON_ARRAY_LENGTHS}")
    foreach(expectation IN LISTS json_array_length_expectations)
      crossgl_split_json_expectation("${expectation}" path expected)
      crossgl_expect_json_array_length("${json}" "${path}" "${expected}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_DIAGNOSTIC)
    crossgl_find_target_record_index("${json}" "" "diagnostics" "code"
                                     "${EXPECTED_DIAGNOSTIC}" diagnostic_index)
  endif()

  if(DEFINED EXPECTED_DIAGNOSTIC_FIELDS)
    if(NOT DEFINED EXPECTED_DIAGNOSTIC)
      message(FATAL_ERROR "EXPECTED_DIAGNOSTIC_FIELDS requires EXPECTED_DIAGNOSTIC")
    endif()
    string(REPLACE "|" ";" diagnostic_expectations
           "${EXPECTED_DIAGNOSTIC_FIELDS}")
    foreach(expectation IN LISTS diagnostic_expectations)
      crossgl_split_json_expectation("${expectation}" field expected)
      crossgl_expect_json_field("${json}" "diagnostics.${diagnostic_index}.${field}" "${expected}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_DIAGNOSTIC_FIELDS_GREATER_THAN)
    if(NOT DEFINED EXPECTED_DIAGNOSTIC)
      message(FATAL_ERROR "EXPECTED_DIAGNOSTIC_FIELDS_GREATER_THAN requires EXPECTED_DIAGNOSTIC")
    endif()
    string(REPLACE "|" ";" diagnostic_greater_than_expectations
           "${EXPECTED_DIAGNOSTIC_FIELDS_GREATER_THAN}")
    foreach(expectation IN LISTS diagnostic_greater_than_expectations)
      crossgl_split_json_expectation("${expectation}" field expected)
      crossgl_expect_json_field_greater_than("${json}" "diagnostics.${diagnostic_index}.${field}" "${expected}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_DIAGNOSTIC_ARRAY_CONTAINS)
    if(NOT DEFINED EXPECTED_DIAGNOSTIC)
      message(FATAL_ERROR "EXPECTED_DIAGNOSTIC_ARRAY_CONTAINS requires EXPECTED_DIAGNOSTIC")
    endif()
    string(REPLACE "|" ";" diagnostic_array_expectations
           "${EXPECTED_DIAGNOSTIC_ARRAY_CONTAINS}")
    foreach(expectation IN LISTS diagnostic_array_expectations)
      crossgl_split_json_expectation("${expectation}" field expected)
      crossgl_expect_json_array_contains("${json}" "diagnostics.${diagnostic_index}.${field}" "${expected}")
    endforeach()
  endif()

  if(DEFINED EXPECTED_DIAGNOSTIC_FIELD_CONTAINS)
    if(NOT DEFINED EXPECTED_DIAGNOSTIC)
      message(FATAL_ERROR "EXPECTED_DIAGNOSTIC_FIELD_CONTAINS requires EXPECTED_DIAGNOSTIC")
    endif()
    string(REPLACE "|" ";" diagnostic_field_contains_expectations
           "${EXPECTED_DIAGNOSTIC_FIELD_CONTAINS}")
    foreach(expectation IN LISTS diagnostic_field_contains_expectations)
      crossgl_split_json_expectation("${expectation}" field expected)
      crossgl_expect_json_field_contains("${json}" "diagnostics.${diagnostic_index}.${field}" "${expected}")
    endforeach()
  endif()

  crossgl_validate_json_schema("${json}")
endfunction()

