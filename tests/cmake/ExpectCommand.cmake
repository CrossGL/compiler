  endif()
  crossgl_apply_json_expectations("${verify_stdout}")
  crossgl_validate_json_schema("${verify_stdout}")
elseif(MODE STREQUAL "package-verify-text")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${TARGET} package verify text build failed: ${stderr}")
  endif()

  set(verify_command "${CGLC}" package verify "${OUTPUT}")
  if(DEFINED VERIFY_SOURCE)
    list(APPEND verify_command --source "${VERIFY_SOURCE}")
  elseif(DEFINED INPUT)
    list(APPEND verify_command --source "${INPUT}")
  endif()
  execute_process(
    COMMAND ${verify_command}
    RESULT_VARIABLE verify_result
    OUTPUT_VARIABLE verify_stdout
    ERROR_VARIABLE verify_stderr
  )
  if(NOT verify_result EQUAL 0)
    message(FATAL_ERROR "package verify text failed: ${verify_stderr}${verify_stdout}")
  endif()
  string(FIND "${verify_stdout}" "verified package " verify_prefix_position)
  if(verify_prefix_position EQUAL -1)
    message(FATAL_ERROR "expected package verify text success, got: ${verify_stdout}")
  endif()
  string(FIND "${verify_stdout}" " for ${TARGET} " verify_target_position)
  if(verify_target_position EQUAL -1)
    message(FATAL_ERROR "expected package verify text to name target ${TARGET}, got: ${verify_stdout}")
  endif()
  if(DEFINED MUST_CONTAIN AND NOT verify_stdout MATCHES "${MUST_CONTAIN}")
    message(FATAL_ERROR "package verify text did not contain '${MUST_CONTAIN}'. Output: ${verify_stdout}")
  endif()
elseif(MODE STREQUAL "package-verify-json-failure")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${FAILURE_KIND} package verify fixture setup failed: ${stderr}")
  endif()

  set(package_path "${OUTPUT}")
  set(verify_command "${CGLC}" package verify "${package_path}" --json)
  if(DEFINED MANIFEST_MUTATION_KIND)
    crossgl_mutate_package_manifest("${package_path}" "${MANIFEST_MUTATION_KIND}")
  endif()
  if(FAILURE_KIND STREQUAL "missing-package")
    file(REMOVE_RECURSE "${package_path}")
  elseif(FAILURE_KIND STREQUAL "invalid-package-dir")
    file(REMOVE_RECURSE "${package_path}")
    file(MAKE_DIRECTORY "${package_path}")
  elseif(FAILURE_KIND STREQUAL "invalid-json-metadata")
    file(WRITE "${package_path}/manifest.json" "{ invalid json\n")
  elseif(FAILURE_KIND STREQUAL "source-mismatch")
    if(DEFINED VERIFY_SOURCE)
      list(APPEND verify_command --source "${VERIFY_SOURCE}")
    else()
      set(mismatched_source "${package_path}-source-mismatch.cgl")
      file(WRITE "${mismatched_source}" "shader WrongSource {\n  compute main() {\n  }\n}\n")
      list(APPEND verify_command --source "${mismatched_source}")
    endif()
  elseif(FAILURE_KIND STREQUAL "missing-native-binary")
    file(READ "${package_path}/manifest.json" manifest)
    string(JSON native_binary ERROR_VARIABLE native_binary_error GET
           "${manifest}" artifacts nativeBinary)
    if(NOT native_binary_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "expected package manifest artifacts.nativeBinary, got: ${native_binary_error}")
    endif()
    file(REMOVE "${package_path}/${native_binary}")
  elseif(FAILURE_KIND STREQUAL "tampered-native-artifact-descriptor")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
    file(READ "${package_path}/manifest.json" manifest)
    string(JSON native_artifact_descriptor ERROR_VARIABLE descriptor_error GET
           "${manifest}" artifacts nativeArtifactDescriptor)
    if(NOT descriptor_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "expected package manifest artifacts.nativeArtifactDescriptor, got: ${descriptor_error}")
    endif()
    set(descriptor_path "${package_path}/${native_artifact_descriptor}")
    file(READ "${descriptor_path}" descriptor)
    string(REPLACE
           "backend/directx/StorageBufferComputeShader.hlsl"
           "backend/directx/TamperedShader.hlsl"
           descriptor "${descriptor}")
    file(WRITE "${descriptor_path}" "${descriptor}")
  elseif(FAILURE_KIND STREQUAL
         "tampered-planned-native-artifact-optimization-level")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
    file(READ "${package_path}/manifest.json" manifest)
    string(JSON native_artifact_descriptor ERROR_VARIABLE descriptor_error GET
           "${manifest}" artifacts nativeArtifactDescriptor)
    if(NOT descriptor_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "expected package manifest artifacts.nativeArtifactDescriptor, got: ${descriptor_error}")
    endif()
    set(descriptor_path "${package_path}/${native_artifact_descriptor}")
    file(READ "${descriptor_path}" descriptor)
    set(original_descriptor "${descriptor}")
    string(REPLACE
           "\"optimizationLevel\": \"O1\""
           "\"optimizationLevel\": \"O3\""
           descriptor "${descriptor}")
    if(descriptor STREQUAL original_descriptor)
      string(REPLACE
             "\"optimizationLevel\": \"unknown\""
             "\"optimizationLevel\": \"O3\""
             descriptor "${descriptor}")
    endif()
    file(WRITE "${descriptor_path}" "${descriptor}")
  elseif(FAILURE_KIND STREQUAL
         "tampered-planned-native-artifact-compiler-tool")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
    file(READ "${package_path}/manifest.json" manifest)
    string(JSON native_artifact_descriptor ERROR_VARIABLE descriptor_error GET
           "${manifest}" artifacts nativeArtifactDescriptor)
    if(NOT descriptor_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "expected package manifest artifacts.nativeArtifactDescriptor, got: ${descriptor_error}")
    endif()
    set(descriptor_path "${package_path}/${native_artifact_descriptor}")
    file(READ "${descriptor_path}" descriptor)
    string(REPLACE
           "      }\n    ],"
           "      },\n      {\n        \"name\": \"dxc\",\n        \"role\": \"compiler\",\n        \"version\": \"fixture\",\n        \"executable\": \"dxc\"\n      }\n    ],"
           descriptor "${descriptor}")
    file(WRITE "${descriptor_path}" "${descriptor}")
  elseif(FAILURE_KIND STREQUAL
         "tampered-unavailable-native-artifact-validator-tool")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
    file(READ "${package_path}/manifest.json" manifest)
    string(JSON native_artifact_descriptor ERROR_VARIABLE descriptor_error GET
           "${manifest}" artifacts nativeArtifactDescriptor)
    if(NOT descriptor_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "expected package manifest artifacts.nativeArtifactDescriptor, got: ${descriptor_error}")
    endif()
    set(descriptor_path "${package_path}/${native_artifact_descriptor}")
    file(READ "${descriptor_path}" descriptor)
    string(REPLACE
           "      }\n    ],"
           "      },\n      {\n        \"name\": \"glslangValidator\",\n        \"role\": \"validator\",\n        \"version\": \"fixture\",\n        \"executable\": \"glslangValidator\"\n      }\n    ],"
           descriptor "${descriptor}")
    file(WRITE "${descriptor_path}" "${descriptor}")
  elseif(FAILURE_KIND STREQUAL "duplicate-selected-target-resource-binding")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
    crossgl_mutate_package_reflection(
      "${package_path}" "duplicate-selected-target-resource-binding")
  elseif(FAILURE_KIND STREQUAL
         "selected-target-resource-binding-array-element-count-mismatch")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
    crossgl_mutate_package_reflection(
      "${package_path}"
      "selected-target-resource-binding-array-element-count-mismatch")
  elseif(FAILURE_KIND STREQUAL
         "selected-target-resource-binding-array-element-count-missing")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
    crossgl_mutate_package_reflection(
      "${package_path}"
      "selected-target-resource-binding-array-element-count-missing")
  elseif(FAILURE_KIND STREQUAL
         "selected-target-resource-binding-array-dimensions-mismatch")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
    crossgl_mutate_package_reflection(
      "${package_path}"
      "selected-target-resource-binding-array-dimensions-mismatch")
  elseif(FAILURE_KIND STREQUAL "malformed-package-artifact-requirements" OR
         FAILURE_KIND STREQUAL "target-conflicting-package-artifact-requirements")
    if(DEFINED INPUT)
      list(APPEND verify_command --source "${INPUT}")
    endif()
  else()
    message(FATAL_ERROR "unknown FAILURE_KIND: ${FAILURE_KIND}")
  endif()

  execute_process(
    COMMAND ${verify_command}
    RESULT_VARIABLE verify_result
    OUTPUT_VARIABLE verify_stdout
    ERROR_VARIABLE verify_stderr
  )
  if(verify_result EQUAL 0)
    message(FATAL_ERROR "expected package verify --json to fail for ${FAILURE_KIND}")
  endif()
  crossgl_apply_json_expectations("${verify_stdout}")
  crossgl_validate_json_schema("${verify_stdout}")
elseif(MODE STREQUAL "package-inspect-json-failure")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${FAILURE_KIND} package inspect fixture setup failed: ${stderr}")
  endif()

  set(package_path "${OUTPUT}")
  if(DEFINED MANIFEST_MUTATION_KIND)
    crossgl_mutate_package_manifest("${package_path}" "${MANIFEST_MUTATION_KIND}")
  endif()
  if(FAILURE_KIND STREQUAL "missing-package")
    file(REMOVE_RECURSE "${package_path}")
  elseif(FAILURE_KIND STREQUAL "non-directory-package")
    file(REMOVE_RECURSE "${package_path}")
    file(WRITE "${package_path}" "not a package directory\n")
  elseif(FAILURE_KIND STREQUAL "invalid-json-metadata")
    file(WRITE "${package_path}/manifest.json" "{ invalid json\n")
  elseif(FAILURE_KIND STREQUAL "malformed-package-artifact-requirements")
    set(_crossgl_inspect_failure_package_mutated TRUE)
  else()
    message(FATAL_ERROR "unknown FAILURE_KIND: ${FAILURE_KIND}")
  endif()

  execute_process(
    COMMAND "${CGLC}" package inspect "${package_path}" --json
    RESULT_VARIABLE inspect_result
    OUTPUT_VARIABLE inspect_stdout
    ERROR_VARIABLE inspect_stderr
  )
  if(inspect_result EQUAL 0)
    message(FATAL_ERROR "expected package inspect --json to fail for ${FAILURE_KIND}")
  endif()
  if(NOT inspect_stderr STREQUAL "")
    message(FATAL_ERROR "package inspect --json must not emit human diagnostics on stderr: ${inspect_stderr}")
  endif()
  crossgl_apply_json_expectations("${inspect_stdout}")
  crossgl_validate_json_schema("${inspect_stdout}")
endif()

