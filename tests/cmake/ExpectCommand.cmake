  if(NOT "${expected_fragments}" STREQUAL "")
    string(REPLACE "|" ";" tool_log_fragments "${expected_fragments}")
    foreach(tool_log_fragment IN LISTS tool_log_fragments)
      crossgl_expect_file_contains("${tool_log}" "${tool_log_fragment}")
    endforeach()
  endif()
endfunction()

