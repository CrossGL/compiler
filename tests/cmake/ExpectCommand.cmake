function(crossgl_validate_package_integrity)
  if(NOT DEFINED PACKAGE_INTEGRITY_VALIDATOR)
    return()
  endif()
  if(NOT DEFINED PYTHON3_EXECUTABLE)
    message(FATAL_ERROR "PYTHON3_EXECUTABLE is required when package integrity validation is enabled")
  endif()

  set(package_integrity_command
      "${PYTHON3_EXECUTABLE}" "${PACKAGE_INTEGRITY_VALIDATOR}"
      --package "${OUTPUT}")
  if(DEFINED INPUT)
    list(APPEND package_integrity_command --source "${INPUT}")
  endif()
  if(DEFINED CGLC)
    list(APPEND package_integrity_command --package-verifier "${CGLC}")
  endif()
  set(package_integrity_uses_json_schema OFF)
  if(DEFINED PACKAGE_SCHEMA_ROOT)
    list(APPEND package_integrity_command
         --schema-root "${PACKAGE_SCHEMA_ROOT}")
    set(package_integrity_uses_json_schema ON)
  endif()
  if(DEFINED MANIFEST_JSON_SCHEMA)
    list(APPEND package_integrity_command
         --manifest-schema "${MANIFEST_JSON_SCHEMA}")
    set(package_integrity_uses_json_schema ON)
  endif()
  if(DEFINED REFLECTION_JSON_SCHEMA)
    list(APPEND package_integrity_command
         --reflection-schema "${REFLECTION_JSON_SCHEMA}")
    set(package_integrity_uses_json_schema ON)
  endif()
  if(DEFINED DIAGNOSTICS_JSON_SCHEMA)
    list(APPEND package_integrity_command
         --diagnostics-schema "${DIAGNOSTICS_JSON_SCHEMA}")
    set(package_integrity_uses_json_schema ON)
  endif()
  if(DEFINED DEBUG_METADATA_JSON_SCHEMA)
    list(APPEND package_integrity_command
         --debug-metadata-schema "${DEBUG_METADATA_JSON_SCHEMA}")
    set(package_integrity_uses_json_schema ON)
  endif()
  if(DEFINED HIR_SOURCE_MAP_JSON_SCHEMA)
    list(APPEND package_integrity_command
         --hir-source-map-schema "${HIR_SOURCE_MAP_JSON_SCHEMA}")
    set(package_integrity_uses_json_schema ON)
  endif()
  if(package_integrity_uses_json_schema)
    if(NOT DEFINED JSON_SCHEMA_VALIDATOR)
      message(FATAL_ERROR "JSON_SCHEMA_VALIDATOR is required when package integrity schema validation is enabled")
    endif()
    list(APPEND package_integrity_command
         --json-schema-validator "${JSON_SCHEMA_VALIDATOR}")
  endif()

  execute_process(
    COMMAND ${package_integrity_command}
    RESULT_VARIABLE package_integrity_result
    OUTPUT_VARIABLE package_integrity_stdout
    ERROR_VARIABLE package_integrity_stderr
  )
  if(NOT package_integrity_result EQUAL 0)
    message(FATAL_ERROR "package integrity validation failed: ${package_integrity_stderr}${package_integrity_stdout}")
  endif()
endfunction()

function(crossgl_expect_file_contains path expected_fragment)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "expected file at ${path}")
  endif()
  file(READ "${path}" file_contents)
  string(FIND "${file_contents}" "${expected_fragment}" fragment_position)
  if(fragment_position EQUAL -1)
    message(FATAL_ERROR "expected ${path} to contain '${expected_fragment}'")
  endif()
endfunction()

function(crossgl_expect_tool_log tool_log expected_fragments)
