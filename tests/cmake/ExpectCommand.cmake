elseif(MODE STREQUAL "package-verify-json-schema")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${TARGET} package verify schema build failed: ${stderr}")
  endif()
  if(NOT EXISTS "${OUTPUT}/manifest.json")
