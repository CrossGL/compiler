function(crossgl_manifest_artifact_path manifest artifact out_var)
  string(JSON raw_path GET "${manifest}" artifacts ${artifact})
  if(IS_ABSOLUTE "${raw_path}")
    set(resolved_path "${raw_path}")
  else()
    set(resolved_path "${OUTPUT}/${raw_path}")
  endif()
  set(${out_var} "${resolved_path}" PARENT_SCOPE)
endfunction()

