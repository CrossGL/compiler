function(crossgl_expect_tool_log log_path expected_fragment)
  if(NOT EXISTS "${log_path}")
    message(FATAL_ERROR "expected fake tool log at ${log_path}")
  endif()
  if(NOT "${expected_fragment}" STREQUAL "")
    file(READ "${log_path}" fake_tool_log)
    string(REPLACE "\\" "/" normalized_fake_tool_log "${fake_tool_log}")
    string(REPLACE "\\" "/" normalized_expected_fragment
           "${expected_fragment}")
    string(REPLACE "|" ";" expected_fragments
           "${normalized_expected_fragment}")
    string(REPLACE "\n" ";" fake_tool_log_lines
           "${normalized_fake_tool_log}")
    foreach(fake_tool_log_line IN LISTS fake_tool_log_lines)
      if(fake_tool_log_line STREQUAL "")
        continue()
      endif()
      set(line_matches ON)
      foreach(expected_line_fragment IN LISTS expected_fragments)
        string(FIND "${fake_tool_log_line}" "${expected_line_fragment}"
               fake_tool_log_position)
        if(fake_tool_log_position EQUAL -1)
          set(line_matches OFF)
          break()
        endif()
      endforeach()
      if(line_matches)
        return()
      endif()
    endforeach()
    message(FATAL_ERROR
