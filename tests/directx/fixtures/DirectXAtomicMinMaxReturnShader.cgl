shader DirectXAtomicMinMaxReturnShader {
  const int GROUP_SIZE = 4;

  compute {
    layout(local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer atomic<int>* counters;
    layout(set = 0, binding = 1) buffer atomic<uint>* unsignedCounters;
    layout(set = 0, binding = 2) buffer int* observed;
    layout(set = 0, binding = 3) buffer uint* unsignedObserved;

    var<workgroup> tile: atomic<int>[GROUP_SIZE];
    var<workgroup> unsignedTile: atomic<uint>[GROUP_SIZE];

    void main() {
      int index = int(gl_GlobalInvocationID.x);
      uint unsignedIndex = gl_LocalInvocationID.x;
      int value = int(gl_LocalInvocationID.x) + 1;
      uint unsignedValue = unsignedIndex + 1u;

      int oldMin = atomicMin(counters[index], value);
      int oldMax = atomicMax(counters[index], value);
      oldMin = atomicMin(counters[index], 1);
      oldMax = atomicMax(counters[index], 2);
      uint oldUnsignedMin = atomicMin(unsignedCounters[unsignedIndex], unsignedValue);
      uint oldUnsignedMax = atomicMax(unsignedCounters[unsignedIndex], unsignedValue);
      int oldShared = atomicMin(tile[index], value);
      uint oldUnsignedShared = atomicMax(unsignedTile[unsignedIndex], unsignedValue);

      atomicMin(counters[index], value);
      atomicMax(unsignedCounters[unsignedIndex], unsignedValue);
      observed[index] = oldMin + oldMax + oldShared;
      unsignedObserved[unsignedIndex] = oldUnsignedMin + oldUnsignedMax + oldUnsignedShared;
      return;
    }
  }
}
