shader DirectXMixedStorageImageAtomicAccessShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0, format = r32i) readwrite uniform iimage2D counters;
    layout(set = 0, binding = 1) buffer int* results;

    void main() {
      ivec2 pixel = ivec2(0, 0);
      int oldValue = imageAtomicAdd(counters, pixel, 1);
      ivec4 loaded = imageLoad(counters, pixel);
      imageStore(counters, pixel, loaded);
      results[0] = oldValue + loaded.x;
      return;
    }
  }
}
