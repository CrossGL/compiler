shader DirectXDynamicNestedFunctionParameterArrayReadUnsupportedShader {
  const int ROWS = 2;
  const int COLS = 3;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    float readGrid(float grid[ROWS][COLS], int row, int col) {
      return grid[row][col];
    }

    void main() {
      float localGrid[ROWS][COLS];
      localGrid[0][0] = values[0];
      localGrid[1][2] = values[1];
      int row = int(values[0]);
      int col = int(values[1]);
      float selected = readGrid(localGrid, row, col);
      values[2] = selected;
      return;
    }
  }
}
