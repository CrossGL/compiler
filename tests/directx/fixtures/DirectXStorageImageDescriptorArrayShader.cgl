shader DirectXStorageImageDescriptorArrayShader {
  const int COUNT = 2;
  const int N = COUNT;

  compute {
    layout(local_size_x = 4, local_size_y = 4, local_size_z = 2) in;
    layout(set = 0, binding = 0) uniform image2D colorImages[COUNT];
    layout(set = 0, binding = 1) uniform iimage2D labelImages[N];
    layout(set = 0, binding = 2) uniform uimage2DArray maskAtlases[N];

    void main() {
      ivec2 pixel = ivec2(int(gl_GlobalInvocationID.x),
                          int(gl_GlobalInvocationID.y));
      int descriptor = int(gl_WorkGroupID.z);
      int layer = int(gl_GlobalInvocationID.z);
      ivec3 texel = ivec3(pixel, layer);

      vec4 color = imageLoad(colorImages[descriptor], pixel);
      imageStore(colorImages[descriptor], pixel, color);

      ivec4 label = imageLoad(labelImages[descriptor], pixel);
      imageStore(labelImages[descriptor], pixel, label);

      uvec4 mask = imageLoad(maskAtlases[descriptor], texel);
      imageStore(maskAtlases[descriptor], texel, mask);
      return;
    }
  }
}
