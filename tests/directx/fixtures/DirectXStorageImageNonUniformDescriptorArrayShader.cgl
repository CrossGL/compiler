shader DirectXStorageImageNonUniformDescriptorArrayShader {
  const int IMAGE_COUNT = 2;

  compute {
    layout(local_size_x = 4, local_size_y = 4, local_size_z = 2) in;
    layout(set = 0, binding = 0) uniform image2D colorImages[IMAGE_COUNT];
    layout(set = 0, binding = 1) uniform iimage2D labelImages[IMAGE_COUNT];
    layout(set = 0, binding = 2) uniform uimage2DArray maskAtlases[IMAGE_COUNT];

    void main() {
      ivec2 pixel = ivec2(int(gl_GlobalInvocationID.x),
                          int(gl_GlobalInvocationID.y));
      int slot = int(gl_WorkGroupID.z);
      int layer = int(gl_GlobalInvocationID.z);
      ivec3 texel = ivec3(pixel, layer);

      vec4 color = imageLoad(colorImages[nonuniform(slot)], pixel);
      imageStore(colorImages[nonuniform(slot)], pixel, color);

      ivec4 label = imageLoad(labelImages[nonuniform(slot)], pixel);
      imageStore(labelImages[nonuniform(slot)], pixel, label);

      uvec4 mask = imageLoad(maskAtlases[nonuniform(slot)], texel);
      imageStore(maskAtlases[nonuniform(slot)], texel, mask);
      return;
    }
  }
}
