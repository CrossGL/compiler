shader DirectXStorageImageAccessQualifierShader {
  compute {
    layout(local_size_x = 4, local_size_y = 4, local_size_z = 2) in;
    layout(set = 0, binding = 0) readonly uniform image2D readColor;
    layout(set = 0, binding = 1) writeonly uniform image2D writeColor;
    layout(set = 0, binding = 2) readwrite uniform image2D readWriteColor;
    layout(set = 0, binding = 3) readonly uniform image2DArray readAtlas;
    layout(set = 0, binding = 4) writeonly uniform image2DArray writeAtlas;
    layout(set = 0, binding = 5) readwrite uniform image2DArray readWriteAtlas;

    void main() {
      ivec2 pixel = ivec2(int(gl_GlobalInvocationID.x),
                          int(gl_GlobalInvocationID.y));
      int layer = int(gl_GlobalInvocationID.z);
      ivec3 texel = ivec3(pixel, layer);

      vec4 color = imageLoad(readColor, pixel);
      imageStore(writeColor, pixel, color);

      vec4 readWriteColorValue = imageLoad(readWriteColor, pixel);
      imageStore(readWriteColor, pixel, readWriteColorValue + color);

      vec4 atlasColor = imageLoad(readAtlas, texel);
      imageStore(writeAtlas, texel, atlasColor);

      vec4 readWriteAtlasValue = imageLoad(readWriteAtlas, texel);
      imageStore(readWriteAtlas, texel, readWriteAtlasValue + atlasColor);
      return;
    }
  }
}
