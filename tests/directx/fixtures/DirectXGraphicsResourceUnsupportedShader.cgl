shader DirectXGraphicsResourceUnsupportedShader {
    struct Transform {
        vec4 offset;
        vec4 tint;
    }

    struct Material {
        vec4 baseColor;
    }

    struct VertexInput {
        vec3 position;
        vec2 texCoord;
    }

    struct VertexOutput {
        vec2 uv;
        vec4 tint;
        vec4 position;
    }

    struct FragmentInput {
        vec2 uv;
        vec4 tint;
    }

    struct FragmentOutput {
        vec4 color;
    }

    vertex {
        layout(set = 0, binding = 0) uniform Transform transform;
        layout(set = 0, binding = 4) buffer mat4* debugMatrices;

        VertexOutput main(VertexInput input) {
            VertexOutput output;
            output.uv = input.texCoord;
            output.tint = transform.tint;
            output.position = vec4(input.position + transform.offset.xyz, 1.0);
            return output;
        }
    }

    fragment {
        layout(set = 0, binding = 1) uniform Material material;
        layout(set = 0, binding = 2) uniform sampler2D colorMap;
        layout(set = 0, binding = 3) sampler linearSampler;
        layout(set = 0, binding = 4) buffer vec4* debugValues[];

        FragmentOutput main(FragmentInput input) {
            FragmentOutput output;
            vec4 sampled = textureLod(colorMap, linearSampler, input.uv, 0.0);
            output.color = sampled * input.tint * material.baseColor;
            return output;
        }
    }
}
