shader DirectXRuntimeUniformBufferDescriptorArrayShader {
  struct Light {
    vec4 color;
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) uniform Light lights[];
    layout(set = 0, binding = 1) buffer vec4* values;

    void main() {
      values[0] = vec4(1.0);
      return;
    }
  }
}
