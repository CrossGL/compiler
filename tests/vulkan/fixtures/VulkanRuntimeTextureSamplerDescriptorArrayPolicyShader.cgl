shader VulkanRuntimeTextureSamplerDescriptorArrayPolicyShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 1) uniform sampler2D maps[];
    layout(set = 0, binding = 2) sampler linearSamplers[];
    void main() {
      vec4 color =
          textureLod(maps[0], linearSamplers[0], vec2(0.25, 0.75), 0.0);
      values[0] = color;
      return;
    }
  }
}
