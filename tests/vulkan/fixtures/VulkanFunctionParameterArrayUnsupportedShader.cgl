shader VulkanFunctionParameterArrayUnsupportedShader {
  const int WEIGHT_COUNT = 2;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

    float sumWeights(float weights[WEIGHT_COUNT]) {
      return weights[0] + weights[1];
    }

    void main(float weights[WEIGHT_COUNT]) {
      float total = sumWeights(weights);
      return;
    }
  }
}
