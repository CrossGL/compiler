shader VulkanAtomicMinMaxNativeShader {
  const int GROUP_SIZE = 4;

  struct CompatCounters {
    int active_count;
    uint spawn_count;
  }

  compute {
    layout(local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

    layout(set = 0, binding = 0) buffer atomic<int>* counters;
    layout(set = 0, binding = 1) buffer atomic<uint>* unsignedCounters;
    layout(set = 0, binding = 2) buffer int* values;
    layout(set = 0, binding = 3) buffer uint* unsignedValues;
    layout(set = 0, binding = 4) buffer CompatCounters compat;
    var<workgroup> tile: atomic<int>[GROUP_SIZE];
    var<workgroup> unsignedTile: atomic<uint>[GROUP_SIZE];

    void main() {
      int index = 0;
      uint localValue = uint(3.0);

      atomicMin(counters[index], 1);
      atomicMax(counters[index], 2);
      atomicMin(unsignedCounters[index], localValue);
      atomicMax(unsignedTile[index], localValue);

      int oldMin = atomicMin(counters[index], 1);
      int oldMax = atomicMax(tile[index], 2);
      uint oldUnsignedMin = atomicMin(unsignedCounters[index], localValue);
      uint oldUnsignedMax = atomicMax(unsignedTile[index], localValue);
      int oldCompat = atomicMax(compat[0].active_count, 1);
      uint oldCompatUnsigned = atomicMin(compat[0].spawn_count, localValue);

      int assignedMin = 0;
      assignedMin = atomicMin(tile[index], 1);
      uint assignedMax = uint(0.0);
      assignedMax = atomicMax(unsignedCounters[index], localValue);

      values[0] = oldMin;
      values[1] = oldMax;
      values[2] = oldCompat;
      values[3] = assignedMin;
      unsignedValues[0] = oldUnsignedMin;
      unsignedValues[1] = oldUnsignedMax;
      unsignedValues[2] = oldCompatUnsigned;
      unsignedValues[3] = assignedMax;
      return;
    }
  }
}
