shader VulkanWritableLocalFunctionParameterArrayShader {
  const int COUNT = 2;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    float sumWeights(float weights[COUNT]) {
      return weights[0] + weights[1];
    }

    void main() {
      float weights[COUNT];
      weights[0] = values[0];
      weights[1] = values[1];
      float value = sumWeights(weights);
      values[2] = value;
      return;
    }
  }
}
