shader VulkanAtomicBitwiseNativeShader {
  const int GROUP_SIZE = 4;

  struct CompatCounters {
    int active_count;
    uint spawn_count;
  }

  compute {
    layout(local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

    layout(set = 0, binding = 0) buffer atomic<int>* counters;
    layout(set = 0, binding = 1) buffer atomic<uint>* unsignedCounters;
    layout(set = 0, binding = 2) buffer int* values;
    layout(set = 0, binding = 3) buffer uint* unsignedValues;
    layout(set = 0, binding = 4) buffer CompatCounters compat;
    var<workgroup> tile: atomic<int>[GROUP_SIZE];
    var<workgroup> unsignedTile: atomic<uint>[GROUP_SIZE];

    void main() {
      int index = 0;
      uint mask = uint(3.0);

      atomicAnd(counters[index], 1);
      atomicOr(tile[index], 2);
      atomicXor(unsignedCounters[index], mask);
      atomicAnd(unsignedTile[index], mask);

      int oldAnd = atomicAnd(counters[index], 1);
      int oldOr = atomicOr(tile[index], 2);
      uint oldXor = atomicXor(unsignedCounters[index], mask);
      uint oldSharedAnd = atomicAnd(unsignedTile[index], mask);
      int oldCompatOr = atomicOr(compat[0].active_count, 1);
      uint oldCompatXor = atomicXor(compat[0].spawn_count, mask);

      int assignedAnd = 0;
      assignedAnd = atomicAnd(tile[index], 1);
      uint assignedOr = uint(0.0);
      assignedOr = atomicOr(unsignedCounters[index], mask);

      values[0] = oldAnd;
      values[1] = oldOr;
      values[2] = oldCompatOr;
      values[3] = assignedAnd;
      unsignedValues[0] = oldXor;
      unsignedValues[1] = oldSharedAnd;
      unsignedValues[2] = oldCompatXor;
      unsignedValues[3] = assignedOr;
      return;
    }
  }
}
