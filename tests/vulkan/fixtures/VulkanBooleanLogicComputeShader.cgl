shader VulkanBooleanLogicComputeShader {
    compute {
        layout(local_size_x = 2, local_size_y = 1, local_size_z = 1) in;
        layout(set = 0, binding = 0) buffer int* values;

        void main() {
            int dynamicIndex = values[0];
            bool positive = dynamicIndex > 0;
            bool small = dynamicIndex < 8;
            bool inside = positive && small;
            bool outside = !inside || dynamicIndex == 13;
            bool same = inside == positive;
            bool different = outside != small;
            values[1] = (same && different) ? 1 : 0;
            return;
        }
    }
}
