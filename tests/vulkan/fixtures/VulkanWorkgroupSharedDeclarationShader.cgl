shader VulkanWorkgroupSharedDeclarationShader {
    const int TILE_WIDTH = 4;

    compute {
        layout(local_size_x = TILE_WIDTH, local_size_y = 2, local_size_z = 1) in;

        layout(set = 0, binding = 0) buffer float* values;
        shared float tile[TILE_WIDTH];

        void main() {
            values[0] = 1.0;
            return;
        }
    }
}
