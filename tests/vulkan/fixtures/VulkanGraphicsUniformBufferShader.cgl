shader VulkanGraphicsUniformBufferShader {
    struct VertexParams {
        vec4 offset;
        vec4 tint;
    }

    struct FragmentParams {
        vec4 baseColor;
    }

    struct VertexInput {
        vec3 position;
        vec2 texCoord;
    }

    struct VertexOutput {
        vec2 uv;
        vec4 tint;
        vec4 position;
    }

    struct FragmentInput {
        vec2 uv;
        vec4 tint;
    }

    struct FragmentOutput {
        vec4 color;
    }

    vertex {
        layout(set = 0, binding = 0) uniform VertexParams vertexParams;

        VertexOutput main(VertexInput input) {
            VertexOutput output;
            output.uv = input.texCoord;
            output.tint = vertexParams.tint;
            output.position = vec4(input.position + vertexParams.offset.xyz,
                                   1.0);
            return output;
        }
    }

    fragment {
        layout(set = 0, binding = 1) uniform FragmentParams fragmentParams;

        FragmentOutput main(FragmentInput input) {
            FragmentOutput output;
            output.color = input.tint * fragmentParams.baseColor;
            return output;
        }
    }
}
