shader VulkanComputeInvocationBuiltinShader {
  compute {
    layout(local_size_x = 8, local_size_y = 4, local_size_z = 2) in;

    layout(set = 0, binding = 0) buffer uvec3* globalIds;
    layout(set = 0, binding = 1) buffer uvec3* localIds;
    layout(set = 0, binding = 2) buffer uvec3* workgroupIds;

    void main() {
      globalIds[0] = gl_GlobalInvocationID;
      localIds[0] = gl_LocalInvocationID;
      workgroupIds[0] = gl_WorkGroupID;
      return;
    }
  }
}
