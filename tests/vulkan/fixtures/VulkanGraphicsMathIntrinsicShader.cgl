shader VulkanGraphicsMathIntrinsicShader {
    struct VertexInput {
        vec3 position;
        vec2 texCoord;
    }

    struct VertexOutput {
        vec2 uv;
        vec4 position;
    }

    struct FragmentInput {
        vec2 uv;
    }

    struct FragmentOutput {
        vec4 color;
    }

    vertex {
        VertexOutput main(VertexInput input) {
            VertexOutput output;
            output.uv = input.texCoord;
            output.position = vec4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        FragmentOutput main(FragmentInput input) {
            FragmentOutput output;
            vec3 normal = normalize(vec3(input.uv, 1.0));
            vec3 light = normalize(vec3(0.0, 0.0, 1.0));
            float intensity = max(dot(normal, light), 0.0);
            vec3 reflected = reflect(-normal, light);
            float fade = length(reflected);
            vec4 warm = vec4(intensity, fade, 0.0, 1.0);
            vec4 cool = vec4(0.0, 0.0, 1.0, 1.0);
            output.color = mix(warm, cool, min(input.uv.x, 1.0));
            return output;
        }
    }
}
