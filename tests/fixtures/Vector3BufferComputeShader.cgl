shader Vector3BufferComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec3* values;

    void main() {
      vec3 color = values[0];
      vec3 lifted = color + vec3(0.5, 0.5, 0.0);
      values[1] = lifted;
      return;
    }
  }
}
