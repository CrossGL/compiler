shader IfComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    void main() {
      float x = values[0];
      float y = 0.0;
      if (x > 0.0) {
        y = x;
      } else {
        y = -x;
      }
      values[1] = y;
      return;
    }
  }
}
