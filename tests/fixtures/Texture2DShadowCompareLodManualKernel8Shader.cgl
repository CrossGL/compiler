shader Texture2DShadowCompareLodManualKernel8Shader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DShadow shadowMap;
    layout(set = 0, binding = 5) sampler rawShadowSampler;

    void main() {
      float visibility =
          textureCompareLodManualKernel8(shadowMap, rawShadowSampler,
                                         vec2(0.5, 0.5), 0.25, 2.0, less,
                                         ivec2(-1, -1), 0.0625,
                                         ivec2(0, -1), 0.125,
                                         ivec2(1, -1), 0.0625,
                                         ivec2(-1, 0), 0.125,
                                         ivec2(1, 0), 0.125,
                                         ivec2(-1, 1), 0.0625,
                                         ivec2(0, 1), 0.125,
                                         ivec2(1, 1), 0.3125);
      values[0] = visibility;
      return;
    }
  }
}
