shader TextureArrayCompareDescriptorArrayLodShader {
  const int SHADOW_COUNT = 2;
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DArrayShadow shadowAtlases[SHADOW_COUNT];
    layout(set = 0, binding = 5) sampler shadowSamplers[2];
    void main() {
      float visibility =
          textureCompareLod(shadowAtlases[1], shadowSamplers[0],
                            vec3(0.25, 0.5, 1.0), 0.33, 2.0);
      values[0] = visibility;
      return;
    }
  }
}
