shader NestedForComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    void main() {
      for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
          int index = i * 2 + j;
          float x = values[index];
          values[index] = x + 1.0;
        }
        values[i] = values[i] + 2.0;
      }
      return;
    }
  }
}
