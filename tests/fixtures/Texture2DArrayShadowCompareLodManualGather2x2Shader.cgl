shader Texture2DArrayShadowCompareLodManualGather2x2Shader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DArrayShadow shadowAtlas;
    layout(set = 0, binding = 5) sampler rawShadowSampler;

    void main() {
      float visibility =
          textureCompareLodManualGather2x2(shadowAtlas, rawShadowSampler,
                                           vec3(0.25, 0.5, 1.0), 0.33, 2.0,
                                           less_equal);
      values[0] = visibility;
      return;
    }
  }
}
