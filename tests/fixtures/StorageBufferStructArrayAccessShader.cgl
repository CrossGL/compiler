shader StorageBufferStructArrayAccessShader {
  struct Particle {
    vec3 position;
    float mass;
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer Particle* particles[2];

    void main() {
      float mass = particles[1][0].mass;
      particles[0][1].mass = mass + 1.0;
      return;
    }
  }
}
