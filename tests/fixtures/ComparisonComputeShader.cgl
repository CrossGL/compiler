shader ComparisonComputeShader {
    compute {
        layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
        layout(set = 0, binding = 0) buffer float* values;

        void main() {
            float x = values[0];
            bool gt = x > 0.0;
            bool le = x <= 1.0;
            int i = 1;
            bool eq = i == 1;
            return;
        }
    }
}
