shader TextureCompareDescriptorArrayLodShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DShadow shadowMaps[2];
    layout(set = 0, binding = 5) sampler shadowSamplers[2];
    void main() {
      float visibility =
          textureCompareLod(shadowMaps[1], shadowSamplers[0],
                            vec2(0.5, 0.5), 0.25, 2.0);
      values[0] = visibility;
      return;
    }
  }
}
