shader LoopComputeShader {
    compute {
        layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
        layout(set = 0, binding = 0) buffer int* values;

        void main() {
            let mut value = int(values[0]);
            loop {
                value++;
                if value >= 4 {
                    break;
                }
                if value == 2 {
                    continue;
                }
                values[value] = value;
            }
            values[0] = value;
            return;
        }
    }
}
