shader MatrixVectorArithmeticComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    void main() {
      vec3 source = vec3(values[0], values[1], 1.0);
      mat3 transform = mat3(
        vec3(1.0, 2.0, 3.0),
        vec3(4.0, 5.0, 6.0),
        vec3(7.0, 8.0, 9.0)
      );
      vec3 result = transform * source;
      values[0] = result.x;
      values[1] = result.y;
      values[2] = result.z;
      return;
    }
  }
}
