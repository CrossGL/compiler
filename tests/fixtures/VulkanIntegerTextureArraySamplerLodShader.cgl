shader VulkanIntegerTextureArraySamplerLodShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer ivec4* values;
    layout(set = 0, binding = 1) buffer uvec4* masks;
    layout(set = 0, binding = 2) uniform isampler2DArray labelAtlas;
    layout(set = 0, binding = 3) uniform usamplerCubeArray maskCubes;
    layout(set = 0, binding = 5) sampler labelSampler;
    layout(set = 0, binding = 6) sampler maskSampler;

    void main() {
      ivec4 label =
          textureLod(labelAtlas, labelSampler, vec3(0.5, 0.5, 1.0), 0.0);
      uvec4 mask =
          textureLod(maskCubes, maskSampler, vec4(0.0, 1.0, 0.0, 2.0), 0.0);
      values[0] = label;
      masks[0] = mask;
      return;
    }
  }
}
