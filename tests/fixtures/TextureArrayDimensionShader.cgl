shader TextureArrayDimensionShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform sampler2DArray atlas;
    layout(set = 0, binding = 3) uniform samplerCubeArray environmentMaps;
    layout(set = 0, binding = 5) sampler linearSampler;

    void main() {
      vec4 atlasColor = textureLod(atlas, linearSampler, vec3(0.25, 0.5, 1.0), 0.0);
      vec4 environmentColor = textureLod(environmentMaps, linearSampler,
                                         vec4(0.0, 1.0, 0.0, 2.0), 1.0);
      values[0] = atlasColor + environmentColor;
      return;
    }
  }
}
