shader VectorScalarCastComputeShader {
  const int OFFSET = 1;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;

    void main() {
      int scale = OFFSET + 1;
      vec4 color = values[0];
      vec4 scaled = color * float(scale);
      vec4 biased = float(1) + scaled;
      values[1] = biased;
      return;
    }
  }
}
