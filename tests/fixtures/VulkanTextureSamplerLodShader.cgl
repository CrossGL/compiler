shader VulkanTextureSamplerLodShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform sampler2D shadowMap;
    layout(set = 0, binding = 5) sampler comparisonSampler;
    void main() {
      vec4 color = textureLod(shadowMap, comparisonSampler, vec2(0.25, 0.75), 1.0);
      values[0] = color;
      return;
    }
  }
}
