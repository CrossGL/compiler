shader RuntimeVectorArrayShader {
  struct RuntimeVectorPayload {
    float count;
    vec4 values[];
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer RuntimeVectorPayload* payloads;

    void main() {
      vec4 first = payloads.values[0];
      payloads.count = 1.0;
      payloads.values[1] = first + vec4(0.25, 0.5, 0.75, 1.0);
      return;
    }
  }
}
