shader Texture2DShadowCompareLodManualKernelListShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DShadow shadowMap;
    layout(set = 0, binding = 6) sampler rawShadowSampler;

    void main() {
      float visibility =
          textureCompareLodManualKernel(
              shadowMap, rawShadowSampler, vec2(0.5, 0.5), 0.25, 2.0,
              less_equal,
              textureCompareKernel(ivec2(0, 0), 0.40,
                                   ivec2(1, 0), 0.15,
                                   ivec2(-1, 0), 0.15,
                                   ivec2(0, 1), 0.15,
                                   ivec2(0, -1), 0.15));
      values[0] = visibility;
      return;
    }
  }
}
