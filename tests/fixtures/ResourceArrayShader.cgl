shader ResourceArrayShader {
  const int LIGHT_COUNT = 4;

  struct Light {
    vec3 direction;
    float intensity;
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) uniform Light lights[LIGHT_COUNT];
    layout(set = 1, binding = 0) uniform Light fallbackLights[2];
    layout(set = 0, binding = 1) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2D shadowMaps[3];
    layout(set = 1, binding = 2) uniform sampler2D detailMaps[2];
    layout(set = 0, binding = 5) sampler comparisonSamplers[2];
    layout(set = 1, binding = 5) sampler fallbackSamplers[2];
    void main() {
      return;
    }
  }
}
