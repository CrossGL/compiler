shader SwitchComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer int* values;
    void main() {
      int mode = values[0];
      int total = 0;
      switch (mode) {
        case 0:
          total = 1;
          break;
        case 1:
          total = 2;
          break;
        default:
          total = 3;
          break;
      }
      values[1] = total;
      return;
    }
  }
}
