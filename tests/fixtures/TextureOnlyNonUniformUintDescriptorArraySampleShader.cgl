shader TextureOnlyNonUniformUintDescriptorArraySampleShader {
  const int TEXTURE_COUNT = 2;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 1) buffer uint* descriptors;
    layout(set = 0, binding = 2) uniform sampler2D colorMaps[TEXTURE_COUNT];
    layout(set = 0, binding = 5) sampler linearSampler;
    void main() {
      uint descriptor = descriptors[0];
      vec4 color = textureLod(colorMaps[nonuniform(descriptor)],
                              linearSampler, vec2(0.5, 0.5), 0.0);
      values[0] = color;
      return;
    }
  }
}
