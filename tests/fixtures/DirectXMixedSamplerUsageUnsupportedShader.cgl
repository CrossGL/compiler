shader DirectXMixedSamplerUsageUnsupportedShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform sampler2D colorMap;
    layout(set = 0, binding = 3) uniform sampler2DShadow shadowMap;
    layout(set = 0, binding = 5) sampler sharedSampler;

    void main() {
      vec4 color =
          textureLod(colorMap, sharedSampler, vec2(0.25, 0.75), 1.0);
      float visibility =
          textureCompare(shadowMap, sharedSampler, vec2(0.5, 0.5), 0.25);
      values[0] = color + vec4(visibility, visibility, 0.0, 1.0);
      return;
    }
  }
}
