shader AtanIntrinsicComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* scalars;
    layout(set = 0, binding = 1) buffer vec4* vectors;

    void main() {
      float slope = atan(scalars[0]);
      float angle = atan(scalars[0], scalars[1]);
      vec4 vectorAngle = atan(vectors[0], vectors[1]);
      scalars[2] = angle + slope;
      vectors[2] = vectorAngle;
      return;
    }
  }
}
