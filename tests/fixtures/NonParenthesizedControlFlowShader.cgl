shader NonParenthesizedControlFlowShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    void main() {
      int index = 0;
      float total = values[0];

      if values[0] > 0.0 {
        total = 1.0;
      } else if values[1] > 0.0 {
        total = 2.0;
      } else {
        total = 3.0;
      }

      while index < 4 {
        total += values[index];
        index++;
      }

      values[0] = total;
      return;
    }
  }
}
