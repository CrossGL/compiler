shader MixedTextureManualCompareDescriptorArrayShader {
  const int RESOURCE_COUNT = 2;
  const int RAW_SAMPLER_COUNT = 2;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform sampler2D colorMaps[RESOURCE_COUNT];
    layout(set = 0, binding = 4) uniform sampler2DShadow shadowMaps[RESOURCE_COUNT];
    layout(set = 0, binding = 6) uniform sampler2DArrayShadow shadowAtlases[RESOURCE_COUNT];
    layout(set = 0, binding = 10) sampler linearSamplers[RESOURCE_COUNT];
    layout(set = 0, binding = 12) sampler shadowSamplers[RESOURCE_COUNT];
    layout(set = 0, binding = 14) sampler rawShadowSamplers[RAW_SAMPLER_COUNT];

    void main() {
      vec4 color =
          textureLod(colorMaps[1], linearSamplers[0], vec2(0.25, 0.75), 1.0);
      float visibility =
          textureCompare(shadowMaps[0], shadowSamplers[1],
                         vec2(0.5, 0.5), 0.25);
      float lodVisibility =
          textureCompareLod(shadowMaps[1], shadowSamplers[0],
                            vec2(0.5, 0.5), 0.33, 2.0);
      float manualVisibility =
          textureCompareLodManual(shadowAtlases[1], rawShadowSamplers[0],
                                  vec3(0.25, 0.5, 1.0), 0.33, 2.0,
                                  less_equal);
      values[0] = color + vec4(visibility, lodVisibility,
                               manualVisibility, 1.0);
      return;
    }
  }
}
