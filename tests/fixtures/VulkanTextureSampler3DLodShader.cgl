shader VulkanTextureSampler3DLodShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform sampler3D volumeMap;
    layout(set = 0, binding = 5) sampler volumeSampler;
    void main() {
      vec4 color = textureLod(volumeMap, volumeSampler, vec3(0.25, 0.5, 0.75), 2.0);
      values[0] = color;
      return;
    }
  }
}
