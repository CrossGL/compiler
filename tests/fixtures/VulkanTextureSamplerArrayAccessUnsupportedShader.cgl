shader VulkanTextureSamplerArrayAccessUnsupportedShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform sampler2D shadowMaps[2];
    layout(set = 0, binding = 5) sampler comparisonSamplers[2];
    void main() {
      vec4 color = shadowMaps[0].sample(comparisonSamplers[0], vec2(0.5, 0.5));
      values[0] = color;
      return;
    }
  }
}
