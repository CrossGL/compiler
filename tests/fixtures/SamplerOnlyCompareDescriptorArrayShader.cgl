shader SamplerOnlyCompareDescriptorArrayShader {
  const int SAMPLER_COUNT = 2;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DShadow shadowMap;
    layout(set = 0, binding = 5) sampler shadowSamplers[SAMPLER_COUNT];
    void main() {
      float visibility =
          textureCompare(shadowMap, shadowSamplers[1], vec2(0.5, 0.5), 0.25);
      values[0] = visibility;
      return;
    }
  }
}
