shader StructNestedFieldComputeShader {
  struct Transform {
    vec3 position;
  }

  struct Particle {
    Transform transform;
    float mass;
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer Particle* particles;

    void main() {
      vec3 position = particles[0].transform.position;
      vec3 lifted = position + vec3(1.0, 0.0, 0.0);
      particles[1].transform.position = lifted;
      particles[1].mass = lifted.x;
      return;
    }
  }
}
