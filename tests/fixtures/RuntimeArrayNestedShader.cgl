shader RuntimeArrayNestedShader {
  struct RuntimeTail {
    float values[];
  }

  struct RuntimePayload {
    RuntimeTail tail;
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer RuntimePayload* payloads;

    void main() {
      payloads[0].tail.values[1] = 1.0;
      return;
    }
  }
}
