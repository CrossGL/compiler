shader VectorBufferComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;

    void main() {
      vec4 color = values[0];
      vec4 lifted = color + vec4(0.5, 0.5, 0.5, 0.0);
      values[1] = lifted;
      return;
    }
  }
}
