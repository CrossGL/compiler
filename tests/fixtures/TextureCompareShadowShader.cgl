shader TextureCompareShadowShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DShadow shadowMap;
    layout(set = 0, binding = 3) uniform samplerCubeShadow cubeShadow;
    layout(set = 0, binding = 5) sampler shadowSampler;

    void main() {
      float visibility =
          textureCompare(shadowMap, shadowSampler, vec2(0.5, 0.5), 0.25);
      float cubeVisibility =
          textureCompare(cubeShadow, shadowSampler, vec3(0.0, 1.0, 0.0), 0.5);
      values[0] = visibility + cubeVisibility;
      return;
    }
  }
}
