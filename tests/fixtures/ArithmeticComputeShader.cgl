shader ArithmeticComputeShader {
    compute {
        layout(local_size_x = 2, local_size_y = 1, local_size_z = 1) in;

        void main() {
            float x = 1.0 + 2.0;
            float y = x * 4.0;
            x = y - -1.0;
            int i = 1 + 2;
            i = i * 3;
            return;
        }
    }
}
