shader RuntimeArrayShader {
  struct RuntimePayload {
    float count;
    float values[];
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer RuntimePayload* payloads;

    void main() {
      payloads.count = 1.0;
      payloads.values[1] = payloads.count;
      return;
    }
  }
}
