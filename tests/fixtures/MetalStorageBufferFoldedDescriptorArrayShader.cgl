shader MetalStorageBufferFoldedDescriptorArrayShader {
  const int DESCRIPTOR_COUNT = 2;
  const int DESCRIPTOR_INDEX = 1;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values[DESCRIPTOR_COUNT];
    void main() {
      float first = values[DESCRIPTOR_INDEX][0];
      values[0][1] = first + 1.0;
      return;
    }
  }
}
