shader ComparisonSamplerRoleShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform sampler2DShadow shadowMap;
    layout(set = 0, binding = 4) comparison_sampler shadowCompareSamplers[2];
    layout(set = 0, binding = 6) uniform sampler2D colorMap;
    layout(set = 0, binding = 8) sampler linearSampler;

    void main() {
      vec4 color =
          textureLod(colorMap, linearSampler, vec2(0.125, 0.875), 0.0);
      float visibility =
          textureCompare(shadowMap, shadowCompareSamplers[0],
                         vec2(0.5, 0.5), 0.25);
      float lodVisibility =
          textureCompareLod(shadowMap, shadowCompareSamplers[1],
                            vec2(0.25, 0.75), 0.33, 1.0);
      values[0] = color + vec4(visibility, lodVisibility, 0.0, 1.0);
      return;
    }
  }
}
