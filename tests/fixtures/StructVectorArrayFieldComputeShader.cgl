shader StructVectorArrayFieldComputeShader {
  struct Particle {
    vec3 positions[2];
    float mass;
  }
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer Particle* particles;
    void main() {
      vec3 lifted = particles[0].positions[1];
      particles[1].positions[0] = lifted;
      return;
    }
  }
}
