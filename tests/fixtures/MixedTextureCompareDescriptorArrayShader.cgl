shader MixedTextureCompareDescriptorArrayShader {
  const int RESOURCE_COUNT = 2;
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform sampler2D colorMaps[RESOURCE_COUNT];
    layout(set = 0, binding = 3) uniform sampler2DShadow shadowMaps[RESOURCE_COUNT];
    layout(set = 0, binding = 5) sampler linearSamplers[2];
    layout(set = 0, binding = 6) sampler shadowSamplers[2];

    void main() {
      vec4 color =
          textureLod(colorMaps[0], linearSamplers[1], vec2(0.25, 0.75), 1.0);
      float visibility =
          textureCompare(shadowMaps[1], shadowSamplers[0], vec2(0.5, 0.5), 0.25);
      float lodVisibility =
          textureCompareLod(shadowMaps[0], shadowSamplers[1],
                            vec2(0.5, 0.5), 0.33, 2.0);
      values[0] = color + vec4(visibility, lodVisibility, 0.0, 1.0);
      return;
    }
  }
}
