shader DoWhileComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    void main() {
      int value = 0;
      float total = 0.0;
      do {
        value = value + 1;
        if (value < 2) {
          continue;
        }
        total += float(value);
      } while (value < 4);
      values[0] = total;
      return;
    }
  }
}
