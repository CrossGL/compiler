shader SamplerOnlyNonUniformCompareLodManualDescriptorArrayShader {
  const int RAW_SAMPLER_COUNT = 2;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 1) buffer int* descriptors;
    layout(set = 0, binding = 2) uniform sampler2DArrayShadow shadowAtlas;
    layout(set = 0, binding = 5) sampler rawShadowSamplers[RAW_SAMPLER_COUNT];

    void main() {
      int descriptor = descriptors[0];
      float visibility =
          textureCompareLodManual(shadowAtlas,
                                  rawShadowSamplers[nonuniform(descriptor)],
                                  vec3(0.25, 0.5, 1.0), 0.33, 2.0,
                                  less_equal);
      values[0] = visibility;
      return;
    }
  }
}
