shader VulkanTextureSamplerCubeArrayLodShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer vec4* values;
    layout(set = 0, binding = 2) uniform samplerCube skyMaps[2];
    layout(set = 0, binding = 5) sampler skySamplers[2];
    void main() {
      vec4 color = textureLod(skyMaps[1], skySamplers[0],
                              vec3(0.0, 1.0, 0.0), 2.0);
      values[0] = color;
      return;
    }
  }
}
