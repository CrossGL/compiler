shader RuntimeStructArrayShader {
  struct TailParticle {
    vec3 position;
    float mass;
  }

  struct RuntimeStructPayload {
    float count;
    TailParticle particles[];
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer RuntimeStructPayload* payloads;

    void main() {
      vec3 firstPosition = payloads.particles[0].position;
      float firstMass = payloads.particles[0].mass;
      payloads.count = firstMass;
      payloads.particles[1].position = firstPosition + vec3(1.0, 0.0, 0.0);
      payloads.particles[1].mass = payloads.count + 1.0;
      return;
    }
  }
}
