shader StorageBufferStructArrayFieldDescriptorArrayShader {
  struct Transform {
    vec3 position;
    float weight;
  }

  struct Particle {
    float weights[4];
    Transform history[2];
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer Particle* particles[2];

    void main() {
      float previousWeight = particles[1][0].weights[2];
      vec3 previousPosition = particles[1][0].history[1].position;
      particles[0][1].weights[3] =
          previousWeight + particles[0][1].history[0].weight;
      particles[0][1].history[0].position = previousPosition;
      return;
    }
  }
}
