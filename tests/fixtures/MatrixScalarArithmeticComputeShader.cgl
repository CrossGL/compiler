shader MatrixScalarArithmeticComputeShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    void keep(mat3 scaled, mat3 rescaled, mat3 inferred) {
      values[0] = 1.0;
      return;
    }

    void main() {
      mat3 transform = mat3(
        vec3(1.0, 2.0, 3.0),
        vec3(4.0, 5.0, 6.0),
        vec3(7.0, 8.0, 9.0)
      );
      mat3 scaled = transform * 2.0;
      mat3 rescaled = 0.5 * transform;
      let mut inferred = transform * 0.25;
      inferred = inferred * 4.0;
      keep(scaled, rescaled, inferred);
      return;
    }
  }
}
