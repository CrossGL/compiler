shader Texture2DShadowCompareLodManualGather2x2Shader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DShadow shadowMap;
    layout(set = 0, binding = 5) sampler rawShadowSampler;

    void main() {
      float visibility =
          textureCompareLodManualGather2x2(shadowMap, rawShadowSampler,
                                           vec2(0.5, 0.5), 0.25, 2.0, less);
      values[0] = visibility;
      return;
    }
  }
}
