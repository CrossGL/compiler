shader ForConstantStrideComputeShader {
  const int TILE_SIZE = 2;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    void main() {
      for (int i = 0; i < 8; i += TILE_SIZE) {
        float x = values[i];
        values[i] = x + 1.0;
      }
      return;
    }
  }
}
