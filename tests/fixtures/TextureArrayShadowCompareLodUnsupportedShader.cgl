shader TextureArrayShadowCompareLodUnsupportedShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;
    layout(set = 0, binding = 2) uniform sampler2DArrayShadow shadowAtlas;
    layout(set = 0, binding = 3) uniform samplerCubeShadow shadowCube;
    layout(set = 0, binding = 5) sampler shadowSampler;

    void main() {
      float atlasVisibility =
          textureCompareLod(shadowAtlas, shadowSampler,
                            vec3(0.25, 0.5, 1.0), 0.33, 2.0);
      float cubeVisibility =
          textureCompareLod(shadowCube, shadowSampler,
                            vec3(0.0, 1.0, 0.0), 0.75, 3.0);
      values[0] = atlasVisibility + cubeVisibility;
      return;
    }
  }
}
