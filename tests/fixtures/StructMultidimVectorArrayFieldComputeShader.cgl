shader StructMultidimVectorArrayFieldComputeShader {
  const int ROWS = 2;
  const int COLS = 3;

  struct Particle {
    vec3 positions[ROWS][COLS];
    float mass;
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer Particle* particles;

    void main() {
      float mass = particles[0].mass;
      particles[1].mass = mass + 1.0;
      return;
    }
  }
}
