shader MetalRuntimeTailFoldedZeroBlockIndexShader {
  const int ZERO = 0;

  struct RuntimePayload {
    float count;
    vec4 values[];
  }

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer RuntimePayload* payloads;
    layout(set = 0, binding = 1) buffer vec4* outputs;
    void main() {
      vec4 first = payloads[ZERO].values[0];
      payloads[ZERO].count = first.x;
      payloads[ZERO].values[1] =
          first + vec4(payloads[ZERO].count, 0.0, 0.0, 0.0);
      outputs[0] = payloads[ZERO].values[1];
      return;
    }
  }
}
