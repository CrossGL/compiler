shader MetalStorageImage2DDescriptorArrayShader {
  const int IMAGE_COUNT = 2;

  compute {
    layout(local_size_x = 4, local_size_y = 4, local_size_z = 1) in;
    layout(set = 0, binding = 0) uniform image2D colorImages[IMAGE_COUNT];
    layout(set = 0, binding = 2) uniform iimage2D labelImages[IMAGE_COUNT];
    layout(set = 0, binding = 4) uniform uimage2D maskImages[IMAGE_COUNT];
    layout(set = 0, binding = 6) buffer int* coordinates;

    void main() {
      ivec2 pixel = ivec2(coordinates[0], coordinates[1]);
      int descriptor = coordinates[2];

      vec4 color = imageLoad(colorImages[descriptor], pixel);
      imageStore(colorImages[1], pixel, color);

      ivec4 label = imageLoad(labelImages[0], pixel);
      imageStore(labelImages[descriptor], pixel, label);

      uvec4 mask = imageLoad(maskImages[descriptor], pixel);
      imageStore(maskImages[0], pixel, mask);
      return;
    }
  }
}
