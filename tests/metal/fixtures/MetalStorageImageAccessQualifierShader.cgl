shader MetalStorageImageAccessQualifierShader {
  compute {
    layout(local_size_x = 4, local_size_y = 4, local_size_z = 1) in;
    layout(set = 0, binding = 0) readonly uniform image2D readColorImage;
    layout(set = 0, binding = 1) writeonly uniform image2D writeColorImage;
    layout(set = 0, binding = 2) readwrite uniform image2D readWriteColorImage;
    layout(set = 0, binding = 3) readonly uniform image2DArray readColorAtlas;
    layout(set = 0, binding = 4) writeonly uniform image2DArray writeColorAtlas;
    layout(set = 0, binding = 5) readwrite uniform image2DArray readWriteColorAtlas;
    layout(set = 0, binding = 6) buffer int* coordinates;

    void main() {
      ivec2 pixel = ivec2(coordinates[0], coordinates[1]);
      int layer = coordinates[2];
      ivec3 atlasPixel = ivec3(pixel, layer);

      vec4 color = imageLoad(readColorImage, pixel);
      imageStore(writeColorImage, pixel, color);

      vec4 readWriteColor = imageLoad(readWriteColorImage, pixel);
      imageStore(readWriteColorImage, pixel, readWriteColor + color);

      vec4 atlasColor = imageLoad(readColorAtlas, atlasPixel);
      imageStore(writeColorAtlas, atlasPixel, atlasColor);

      vec4 readWriteAtlasColor = imageLoad(readWriteColorAtlas, atlasPixel);
      imageStore(readWriteColorAtlas, atlasPixel,
                 readWriteAtlasColor + atlasColor);
      return;
    }
  }
}
