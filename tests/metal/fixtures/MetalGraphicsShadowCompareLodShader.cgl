shader MetalGraphicsShadowCompareLodShader {
    struct MeshVertex {
        vec3 position;
        vec2 texCoord;
        float shadowDepth;
    }

    struct RasterPayload {
        vec4 clipPosition;
        vec2 uv;
        float shadowDepth;
    }

    struct FragmentPayload {
        vec2 uv;
        float shadowDepth;
    }

    struct ColorTarget {
        vec4 color;
    }

    vertex {
        RasterPayload main(MeshVertex input) {
            RasterPayload output;
            output.clipPosition = vec4(input.position, 1.0);
            output.uv = input.texCoord;
            output.shadowDepth = input.shadowDepth;
            return output;
        }
    }

    fragment {
        layout(set = 0, binding = 2) uniform sampler2DShadow shadowMap;
        layout(set = 0, binding = 5) comparison_sampler shadowCompareSampler;

        ColorTarget main(FragmentPayload input) {
            ColorTarget output;
            float visibility =
                textureCompareLod(shadowMap, shadowCompareSampler, input.uv,
                                  input.shadowDepth, 2.0);
            output.color = vec4(visibility, visibility, visibility, 1.0);
            return output;
        }
    }
}
