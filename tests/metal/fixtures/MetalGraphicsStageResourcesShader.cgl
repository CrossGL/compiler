shader MetalGraphicsStageResourcesShader {
    struct FrameParams {
        vec4 offset;
        vec4 tint;
    }

    struct MeshVertex {
        vec3 position;
        vec2 texCoord;
    }

    struct RasterPayload {
        vec4 clipPosition;
        vec2 uv;
        vec4 tint;
    }

    struct FragmentPayload {
        vec2 uv;
        vec4 tint;
    }

    struct ColorTarget {
        vec4 color;
    }

    vertex {
        layout(set = 0, binding = 0) uniform FrameParams frame;

        RasterPayload main(MeshVertex input) {
            RasterPayload output;
            output.clipPosition = vec4(input.position + frame.offset.xyz, 1.0);
            output.uv = input.texCoord;
            output.tint = frame.tint;
            return output;
        }
    }

    fragment {
        layout(set = 0, binding = 2) uniform sampler2D colorMap;
        layout(set = 0, binding = 3) sampler linearSampler;

        ColorTarget main(FragmentPayload input) {
            ColorTarget output;
            vec4 sampled = texture(colorMap, linearSampler, input.uv);
            output.color = sampled * input.tint;
            return output;
        }
    }
}
