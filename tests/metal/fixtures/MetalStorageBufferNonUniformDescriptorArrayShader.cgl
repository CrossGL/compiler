shader MetalStorageBufferNonUniformDescriptorArrayShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values[2];
    layout(set = 0, binding = 4) buffer int* descriptors;
    void main() {
      int descriptor = descriptors[0];
      float first = values[nonuniform(descriptor)][0];
      values[0][1] = first;
      return;
    }
  }
}
