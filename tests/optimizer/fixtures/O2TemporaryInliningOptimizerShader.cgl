shader O2TemporaryInliningOptimizerShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    float combineScalar(float left, float right) {
      float scalarInline = left + right;
      return scalarInline;
    }

    float keepScalarMultipleReads(float left, float right) {
      float scalarReadTwice = left + right;
      return scalarReadTwice + scalarReadTwice;
    }

    float consumeVector(vec4 value) {
      return value.x + value.y + value.z + value.w;
    }

    void main() {
      vec4 vectorInline = vec4(0.25, 0.5, 0.75, 1.0);
      values[0] = combineScalar(values[0], values[1]);
      values[1] = consumeVector(vectorInline);
      values[2] = keepScalarMultipleReads(values[2], values[3]);

      float scalarResourceRead = values[4];
      values[4] = scalarResourceRead;

      vec4 vectorReadTwice = vec4(1.0, 2.0, 3.0, 4.0);
      values[5] = consumeVector(vectorReadTwice) + consumeVector(vectorReadTwice);
      return;
    }
  }
}
