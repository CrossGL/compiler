shader StorageImageArrayOptimizerBoundaryShader {
  const int IMAGE_COUNT = 2;

  compute {
    layout(local_size_x = 4, local_size_y = 4, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer int* descriptors;
    layout(set = 0, binding = 1) uniform image2D colorImages[IMAGE_COUNT];
    layout(set = 0, binding = 2) uniform iimage2D labelImages[IMAGE_COUNT];
    layout(set = 0, binding = 3) uniform uimage2DArray maskAtlases[IMAGE_COUNT];

    void main() {
      ivec2 pixel = ivec2(int(gl_GlobalInvocationID.x),
                          int(gl_GlobalInvocationID.y));
      int layer = int(gl_GlobalInvocationID.z);
      int dynamicSlot = descriptors[0];
      vec4 seed = vec4(1.0, 0.0, 0.0, 1.0);
      int deadBefore = dynamicSlot + pixel.x;
      vec4 deadColor = seed + vec4(0.25, 0.25, 0.25, 0.0);

      imageStore(colorImages[1], pixel, seed);
      vec4 dynamicColor = imageLoad(colorImages[dynamicSlot], pixel);
      imageLoad(colorImages[0], pixel);
      imageStore(colorImages[dynamicSlot], pixel + ivec2(1, 0), dynamicColor);

      ivec4 label = imageLoad(labelImages[1], pixel);
      imageStore(labelImages[dynamicSlot], pixel + ivec2(0, 1), label);

      uvec4 mask = imageLoad(maskAtlases[dynamicSlot], ivec3(pixel, layer));
      imageStore(maskAtlases[1], ivec3(pixel, layer + 1), mask);

      int deadAfter = deadBefore + label.x;
      vec4 deadTail = deadColor + dynamicColor;
      return;
    }
  }
}
