shader OpenGLGraphicsShadowCompareLodResourcesShader {
    struct VertexInput {
        vec3 position;
        vec2 texCoord;
    }

    struct VertexOutput {
        vec2 uv;
        vec4 position;
    }

    struct FragmentInput {
        vec2 uv;
    }

    struct FragmentOutput {
        vec4 color;
    }

    vertex {
        VertexOutput main(VertexInput input) {
            VertexOutput output;
            output.uv = input.texCoord;
            output.position = vec4(input.position, 1.0);
            return output;
        }
    }

    fragment {
        layout(set = 0, binding = 2) uniform sampler2DShadow shadowMap;
        layout(set = 0, binding = 3) comparison_sampler shadowSampler;

        FragmentOutput main(FragmentInput input) {
            FragmentOutput output;
            float visibility = textureCompareLod(shadowMap, shadowSampler,
                                                 input.uv, 0.5, 1.5);
            output.color = vec4(visibility, input.uv.x, input.uv.y, 1.0);
            return output;
        }
    }
}
