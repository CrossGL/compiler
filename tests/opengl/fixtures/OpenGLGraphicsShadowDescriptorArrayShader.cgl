shader OpenGLGraphicsShadowDescriptorArrayShader {
    const int SHADOW_COUNT = 2;

    struct VertexInput {
        vec3 position;
        vec2 texCoord;
    }

    struct VertexOutput {
        vec2 uv;
        vec4 position;
    }

    struct FragmentInput {
        vec2 uv;
    }

    struct FragmentOutput {
        vec4 color;
    }

    vertex {
        layout(set = 0, binding = 6) uniform sampler2DShadow vertexShadowMaps[SHADOW_COUNT];
        layout(set = 0, binding = 7) comparison_sampler vertexShadowSamplers[SHADOW_COUNT];

        VertexOutput main(VertexInput input) {
            VertexOutput output;
            int shadowIndex = 1;
            float visibility = textureCompareLod(
                vertexShadowMaps[shadowIndex], vertexShadowSamplers[0],
                input.texCoord, 0.5, 0.0);
            output.uv = input.texCoord;
            output.position = vec4(
                input.position.x, input.position.y, input.position.z + visibility, 1.0);
            return output;
        }
    }

    fragment {
        layout(set = 0, binding = 8) uniform sampler2DArrayShadow shadowAtlases[SHADOW_COUNT];
        layout(set = 0, binding = 9) comparison_sampler atlasSamplers[SHADOW_COUNT];

        FragmentOutput main(FragmentInput input) {
            FragmentOutput output;
            int atlasIndex = 1;
            float atlasVisibility = textureCompare(
                shadowAtlases[atlasIndex], atlasSamplers[0],
                vec3(input.uv, 0.0), 0.5);
            output.color = vec4(atlasVisibility, input.uv.x, input.uv.y, 1.0);
            return output;
        }
    }
}
