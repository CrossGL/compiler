shader OpenGLGraphicsResourcesShader {
    struct FrameParams {
        vec4 tint;
        float zBias;
    }

    struct VertexInput {
        vec3 position;
        vec2 texCoord;
    }

    struct VertexOutput {
        vec2 uv;
        vec4 position;
    }

    struct FragmentInput {
        vec2 uv;
    }

    struct FragmentOutput {
        vec4 color;
    }

    vertex {
        layout(set = 0, binding = 0) uniform FrameParams vertexParams;

        VertexOutput main(VertexInput input) {
            VertexOutput output;
            output.uv = input.texCoord;
            output.position = vec4(input.position.x, input.position.y,
                                   input.position.z + vertexParams.zBias, 1.0);
            return output;
        }
    }

    fragment {
        layout(set = 0, binding = 1) uniform FrameParams fragmentParams;

        FragmentOutput main(FragmentInput input) {
            FragmentOutput output;
            output.color = vec4(input.uv.x, input.uv.y, 1.0,
                                fragmentParams.tint.w);
            return output;
        }
    }
}
