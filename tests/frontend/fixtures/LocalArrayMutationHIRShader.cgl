shader LocalArrayMutationHIRShader {
  const int COUNT = 2;

  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    float rewriteWeight(float samples[COUNT]) {
      samples[0] = samples[1];
      return samples[0];
    }

    void main() {
      float weights[COUNT];
      weights[0] = values[0];
      weights[1] = values[1];
      float first = rewriteWeight(weights);
      values[0] = first;
      return;
    }
  }
}
