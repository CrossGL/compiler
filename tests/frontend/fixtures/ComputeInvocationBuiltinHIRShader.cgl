shader ComputeInvocationBuiltinHIRShader {
    compute {
        layout(local_size_x = 8, local_size_y = 4, local_size_z = 2) in;
        layout(set = 0, binding = 0) buffer uint* values;

        void main() {
            uint globalX = gl_GlobalInvocationID.x;
            uint localY = gl_LocalInvocationID.y;
            uint groupZ = gl_WorkGroupID.z;
            values[globalX] = globalX + localY + groupZ;
            return;
        }
    }
}
