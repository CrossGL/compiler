shader ForIncrementDecrementHIRShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer float* values;

    void main() {
      float total = 0.0;

      for (int i = 0; i < 4; i++) {
        total += float(i);
      }

      for (int j = 0; j < 4; ++j) {
        total += float(j);
      }

      for (int k = 4; k > 0; k--) {
        total += float(k);
      }

      for (int m = 4; m > 0; --m) {
        total += float(m);
      }

      int tail = 0;
      tail++;
      ++tail;
      tail--;
      --tail;
      total += float(tail);
      values[0] = total;
      return;
    }
  }
}
