shader AtomicAddHIRShader {
  const int GROUP_SIZE = 8;

  compute {
    layout(local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer atomic<int>* counters;
    layout(set = 0, binding = 1) buffer int* deltas;

    var<workgroup> tile: array<atomic<int>, GROUP_SIZE>;

    void main() {
      int globalIndex = int(gl_GlobalInvocationID.x);
      int localIndex = int(gl_LocalInvocationID.x);
      int delta = deltas[globalIndex];
      atomicAdd(counters[globalIndex], delta);
      atomicAdd(tile[localIndex], 1);
      return;
    }
  }
}
