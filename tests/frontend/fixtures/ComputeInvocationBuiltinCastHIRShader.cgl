shader ComputeInvocationBuiltinCastHIRShader {
    compute {
        layout(local_size_x = 8, local_size_y = 4, local_size_z = 2) in;
        layout(set = 0, binding = 0) buffer int* values;

        void main() {
            int globalX = int(gl_GlobalInvocationID.x);
            int localX = int(gl_LocalInvocationID.x);
            int localY = int(gl_LocalInvocationID.y);
            int groupX = int(gl_WorkGroupID.x);
            int groupY = int(gl_WorkGroupID.y);
            values[globalX] = localX + localY + groupX + groupY;
            return;
        }
    }
}
