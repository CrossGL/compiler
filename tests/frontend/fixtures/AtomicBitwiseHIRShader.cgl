shader AtomicBitwiseHIRShader {
  const int GROUP_SIZE = 4;

  struct CompatCounters {
    int active_count;
    uint spawn_count;
  }

  compute {
    layout(local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer atomic<int>* counters;
    layout(set = 0, binding = 1) buffer atomic<uint>* unsignedCounters;
    layout(set = 0, binding = 2) buffer int* values;
    layout(set = 0, binding = 3) buffer uint* unsignedValues;
    layout(set = 0, binding = 4) buffer CompatCounters compat;

    var<workgroup> tile: array<atomic<int>, GROUP_SIZE>;
    var<workgroup> unsignedTile: array<atomic<uint>, GROUP_SIZE>;

    void main() {
      uint index = gl_LocalInvocationID.x;
      int mask = values[index];
      uint unsignedMask = unsignedValues[index];

      atomicAnd(counters[index], mask);
      atomicOr(unsignedCounters[index], unsignedMask);
      atomicXor(compat.active_count, mask);
      int oldAnd = atomicAnd(counters[index], mask);
      oldAnd = atomicAnd(tile[index], 1);
      uint oldAndCompat = atomicAnd(compat.spawn_count, unsignedMask);
      int oldOr = atomicOr(counters[index], mask);
      oldOr = atomicOr(tile[index], 1);
      uint oldOrU = atomicOr(unsignedCounters[index], unsignedMask);
      int oldXor = atomicXor(counters[index], mask);
      oldXor = atomicXor(counters[index], 1);
      uint oldXorShared = atomicXor(unsignedTile[index], unsignedMask);

      values[index] = oldAnd + oldOr + oldXor;
      unsignedValues[index] = oldAndCompat + oldOrU + oldXorShared;
      return;
    }
  }
}
