shader AtomicAddReturnHIRShader {
  const int GROUP_SIZE = 4;

  struct CompatCounters {
    int active_count;
    uint spawn_count;
  }

  compute {
    layout(local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer atomic<int>* counters;
    layout(set = 0, binding = 1) buffer atomic<uint>* unsignedCounters;
    layout(set = 0, binding = 2) buffer int* values;
    layout(set = 0, binding = 3) buffer uint* unsignedValues;
    layout(set = 0, binding = 4) buffer CompatCounters compat;

    var<workgroup> tile: array<atomic<int>, GROUP_SIZE>;

    void main() {
      uint index = gl_LocalInvocationID.x;
      int delta = values[index];

      atomicAdd(counters[index], delta);
      int oldDeclared = atomicAdd(counters[index], delta);
      int oldAssigned = 0;
      oldAssigned = atomicAdd(counters[index], 1);
      uint oldUnsigned = atomicAdd(unsignedCounters[index], index);
      int oldShared = atomicAdd(tile[index], 1);
      int oldCompat = atomicAdd(compat.active_count, 1);

      values[index] = oldDeclared + oldAssigned + oldShared + oldCompat;
      unsignedValues[index] = oldUnsigned;
      return;
    }
  }
}
