shader AtomicExchangeHIRShader {
  const int GROUP_SIZE = 4;

  struct CompatCounters {
    int active_count;
    uint spawn_count;
  }

  compute {
    layout(local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer atomic<int>* counters;
    layout(set = 0, binding = 1) buffer atomic<uint>* unsignedCounters;
    layout(set = 0, binding = 2) buffer int* values;
    layout(set = 0, binding = 3) buffer uint* unsignedValues;
    layout(set = 0, binding = 4) buffer CompatCounters compat;

    var<workgroup> tile: array<atomic<int>, GROUP_SIZE>;
    var<workgroup> unsignedTile: array<atomic<uint>, GROUP_SIZE>;

    void main() {
      uint index = gl_LocalInvocationID.x;
      int value = values[index];
      uint unsignedValue = unsignedValues[index];

      atomicExchange(counters[index], value);
      atomicExchange(unsignedCounters[index], unsignedValue);
      atomicExchange(compat.active_count, value);
      atomicExchange(compat.spawn_count, unsignedValue);
      int oldStorage = atomicExchange(counters[index], value);
      oldStorage = atomicExchange(counters[index], 1);
      uint oldUnsigned = atomicExchange(unsignedCounters[index], unsignedValue);
      int oldShared = atomicExchange(tile[index], value);
      uint oldSharedU = atomicExchange(unsignedTile[index], unsignedValue);
      int oldCompat = atomicExchange(compat.active_count, 1);
      uint oldCompatU = atomicExchange(compat.spawn_count, unsignedValue);

      values[index] = oldStorage + oldShared + oldCompat;
      unsignedValues[index] = oldUnsigned + oldSharedU + oldCompatU;
      return;
    }
  }
}
