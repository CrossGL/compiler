shader WorkgroupSharedMemoryHIRShader {
    const int BASE_WIDTH = 4;
    const int GROUP_WIDTH = BASE_WIDTH * 2;
    const int GROUP_HEIGHT = 4;

    compute {
        layout(local_size_x = GROUP_WIDTH, local_size_y = GROUP_HEIGHT, local_size_z = 1) in;

        shared float tile[GROUP_WIDTH];

        void main() {
            tile[0] = 1.0;
            float cached = tile[0];
            tile[1] = cached + 2.0;
            return;
        }
    }
}
