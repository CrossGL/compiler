shader BadTextureCompareLodManualKernelShapeShader {
  compute {
    uniform samplerCubeShadow shadowCube;
    sampler rawShadowSampler;
    void main() {
      float visibility =
          textureCompareLodManualKernel4(shadowCube, rawShadowSampler,
                                         vec3(0.0, 1.0, 0.0), 0.5, 1.0,
                                         greater_equal,
                                         ivec2(-1, 0), 0.25,
                                         ivec2(0, 0), 0.25,
                                         ivec2(1, 0), 0.25,
                                         ivec2(0, 1), 0.25);
      return;
    }
  }
}
