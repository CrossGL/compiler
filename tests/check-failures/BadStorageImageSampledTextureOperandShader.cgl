shader BadStorageImageSampledTextureOperandShader {
  compute {
    layout(set = 0, binding = 0) uniform sampler2D sampledColor;

    void main() {
      ivec2 pixel = ivec2(0, 0);
      vec4 color = imageLoad(sampledColor, pixel);
      imageStore(sampledColor, pixel, color);
      return;
    }
  }
}
