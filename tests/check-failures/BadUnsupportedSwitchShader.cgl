shader BadUnsupportedSwitch {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) buffer int* values;
    void main() {
      int mode = values[0];
      switch (mode) {
        case 0:
          values[1] = 1;
        default:
          values[1] = 2;
          break;
      }
      return;
    }
  }
}
