shader BadTextureCompareLodManualKernelWeightShader {
  compute {
    uniform sampler2DShadow shadowMap;
    sampler rawShadowSampler;
    void main() {
      float visibility =
          textureCompareLodManualKernel4(shadowMap, rawShadowSampler,
                                         vec2(0.5, 0.5), 0.25, 2.0, less,
                                         ivec2(-1, 0), true,
                                         ivec2(0, 0), 0.25,
                                         ivec2(1, 0), 0.25,
                                         ivec2(0, 1), 0.25);
      return;
    }
  }
}
