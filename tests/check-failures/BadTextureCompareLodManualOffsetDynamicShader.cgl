shader BadTextureCompareLodManualOffsetDynamicShader {
  compute {
    uniform sampler2DShadow shadowMap;
    sampler rawShadowSampler;
    void main() {
      ivec2 offset = ivec2(1, -1);
      float visibility =
          textureCompareLodManualOffset(shadowMap, rawShadowSampler,
                                        vec2(0.5, 0.5), 0.25, 2.0, less,
                                        offset);
      return;
    }
  }
}
