shader BadStorageImageLoadCoordinateShapeShader {
  compute {
    layout(set = 0, binding = 0) uniform image2D colorImage;
    layout(set = 0, binding = 1) uniform uimage2DArray maskAtlas;

    void main() {
      vec4 color = imageLoad(colorImage, ivec3(0, 1, 2));
      uvec4 mask = imageLoad(maskAtlas, ivec2(0, 1));
      return;
    }
  }
}
