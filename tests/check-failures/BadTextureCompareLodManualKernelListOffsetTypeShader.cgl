shader BadTextureCompareLodManualKernelListOffsetTypeShader {
  compute {
    uniform sampler2DShadow shadowMap;
    sampler rawShadowSampler;
    void main() {
      float visibility =
          textureCompareLodManualKernel(
              shadowMap, rawShadowSampler, vec2(0.5, 0.5), 0.25, 2.0, less,
              textureCompareKernel(ivec2(0, 0), 0.40,
                                   vec2(0.0, 1.0), 0.15,
                                   ivec2(1, 0), 0.45));
      return;
    }
  }
}
