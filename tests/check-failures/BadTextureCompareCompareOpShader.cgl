shader BadTextureCompareCompareOpShader {
  compute {
    uniform sampler2DShadow shadowMap;
    sampler rawShadowSampler;
    void main() {
      float visibility =
          textureCompareLodManual(shadowMap, rawShadowSampler,
                                  vec2(0.5, 0.5), 0.25, 2.0, true);
      return;
    }
  }
}
