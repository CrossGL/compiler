shader BadStorageImageReadWriteAccessShader {
  compute {
    layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
    layout(set = 0, binding = 0) readonly uniform image2D readImages[2];
    layout(set = 0, binding = 1) writeonly uniform image2D writeImages[2];

    void main() {
      int slot = 1;
      ivec2 pixel = ivec2(0, 0);
      imageStore((readImages[slot]), pixel, vec4(0.0));
      vec4 color = imageLoad((writeImages[slot]), pixel);
      return;
    }
  }
}
