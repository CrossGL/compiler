shader BadTextureCompareLodManualKernelDynamicOffsetShader {
  compute {
    uniform sampler2DShadow shadowMap;
    sampler rawShadowSampler;
    void main() {
      ivec2 offset = ivec2(-1, 0);
      float visibility =
          textureCompareLodManualKernel4(shadowMap, rawShadowSampler,
                                         vec2(0.5, 0.5), 0.25, 2.0, less,
                                         offset, 0.25,
                                         ivec2(0, 0), 0.25,
                                         ivec2(1, 0), 0.25,
                                         ivec2(0, 1), 0.25);
      return;
    }
  }
}
